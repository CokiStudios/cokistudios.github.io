<Window x:Class="ShineFind.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:local="clr-namespace:ShineFind.Windows"
        mc:Ignorable="d"
        Title="Shine Find Browser — Coki Studios (CEF NootedRed Engine)" Height="720" Width="1280"
        Background="#06090F" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── TOOLBAR SUPERIOR (SHINE UI) ── -->
        <Border Grid.Row="0" Background="#0D121F" BorderBrush="#2538bdf8" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- Botones de Navegación -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,12,0">
                    <Button Name="BtnBack" Content="◀" Width="32" Height="32" Margin="0,0,4,0" Background="#1A2235" Foreground="#38BDF8" BorderThickness="0" CornerRadius="8" Click="BtnBack_Click"/>
                    <Button Name="BtnForward" Content="▶" Width="32" Height="32" Margin="0,0,4,0" Background="#1A2235" Foreground="#38BDF8" BorderThickness="0" CornerRadius="8" Click="BtnForward_Click"/>
                    <Button Name="BtnReload" Content="🔄" Width="32" Height="32" Margin="0,0,8,0" Background="#1A2235" Foreground="#38BDF8" BorderThickness="0" CornerRadius="8" Click="BtnReload_Click"/>
                </StackPanel>

                <!-- Status Badges & Controles -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <!-- Toggle NootedRed Hackintosh Mode -->
                    <Button Name="BtnNootedRed" Content="🍒 NootedRed Mode: OFF" Padding="10,4" Margin="0,0,8,0" Background="#26EF4444" Foreground="#EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="8" FontWeight="Bold" FontSize="11" Click="BtnNootedRed_Click"/>
                    
                    <!-- Escudo Sentinel Anti-Tracker -->
                    <Border Padding="8,4" Margin="0,0,8,0" Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="🛡️ Sentinel Shield: ON" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <!-- CSID Indicator -->
                    <Border Padding="8,4" Background="#1F38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="🪪 CSID Connected" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Barra de Direcciones -->
                <Border Background="#06090F" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔒 " VerticalAlignment="Center" Foreground="#10B981"/>
                        <TextBox Grid.Column="1" Name="TxtAddress" Text="https://cokistudios.github.io/forkar.html" Background="Transparent" Foreground="#F1F5F9" BorderThickness="0" FontSize="13" FontFamily="Consolas, JetBrains Mono" VerticalAlignment="Center" KeyDown="TxtAddress_KeyDown"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ── MOTOR DE RENDERIZADO CEF CHROMIUM ── -->
        <Grid Grid.Row="1" Background="#06090F">
            <cef:ChromiumWebBrowser Name="Browser" Address="https://cokistudios.github.io/forkar.html"/>
        </Grid>

        <!-- ── FOOTER STATUS BAR ── -->
        <Border Grid.Row="2" Background="#0A0E1A" BorderBrush="#1F2538bdf8" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Shine Find Browser v1.0 — Powered by Chromium CEF 122 C++ Core Engine" Foreground="#64748B" FontSize="11"/>
                <TextBlock DockPanel.Dock="Right" Name="TxtStatus" Text="Ready (Hardware Accelerated)" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
