<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Habilitar App Sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Acceso a Internet (Cliente para cargar CSMS y Supabase) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Acceso al Portapapeles (Copiar/Pegar) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Acceso a Audio/Micrófono para llamadas o mensajes de voz -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Acceso a Cámara para videollamadas o fotos de perfil -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
