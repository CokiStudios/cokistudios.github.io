# ── 2. COMMAND: INSTALL (Install module or project dependencies) ──
cmd_install() {
    local mod_name="$1"

    # If no module argument is given, install all dependencies from local smile.json
    if [ -z "$mod_name" ]; then
        if [ -f "./smile.json" ]; then
            echo -e "${C_CYAN}⚡ smiledev install:${C_RESET} Reading dependencies from ./smile.json..."
            local deps_list
            deps_list=$(python3 -c "
import json
try:
    with open('./smile.json') as f:
        d = json.load(f)
    deps = list(d.get('dependencies', {}).keys())
    print(' '.join(deps))
except Exception:
    print('')
")
            if [ -z "$deps_list" ]; then
                echo -e "  ${C_YELLOW}No dependencies found in ./smile.json.${C_RESET}"
                echo -e "  To install a module: ${C_CYAN}smiledev install <module-name>${C_RESET}"
                return 0
            fi

            for dep in $deps_list; do
                echo -e "\n• Installing dependency: ${C_BOLD}$dep${C_RESET}"
                cmd_install "$dep"
            done
            echo -e "\n${C_GREEN}✔ [SUCCESS]${C_RESET} All dependencies installed successfully."
            return 0
        else
            echo -e "${C_RED}✘ Error:${C_RESET} You must specify a module to install or run in a directory with smile.json."
            echo -e "   Example: ${C_CYAN}smiledev install loop-core-utils${C_RESET}"
            exit 1
        fi
    fi

    echo -e "${C_CYAN}⚡ smiledev install:${C_RESET} Searching for ${C_BOLD}$mod_name${C_RESET} in LoopModules..."
    local res
    res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                 -H "Authorization: Bearer $SUPABASE_KEY" \
                 "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name&select=*")

    local is_found
    is_found=$(echo "$res" | python3 -c "import sys, json; data=json.load(sys.stdin); print('1' if data else '0')" 2>/dev/null || echo "0")

    if [ "$is_found" != "1" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Module '$mod_name' not found in LoopModules registry."
        exit 1
    fi

    local target_dir="$(pwd)/modules/$mod_name"
    mkdir -p "$(pwd)/modules"

    # Extract details and code payload
    echo "$res" | python3 -c '
import sys, json, os

data = json.load(sys.stdin)[0]
name = data["name"]
lang = data.get("language", "loop")
ver = data.get("version", "1.0.0")
entry = data.get("entry_point") or (f"{name}.py" if lang=="python" else (f"{name}.hpp" if lang=="cpp" else (f"{name}.c2" if lang=="c2" else f"{name}.loop")))
payload = data.get("code_payload") or ""
if "\\n" in payload and "\n" not in payload:
    payload = payload.replace("\\n", "\n").replace("\\t", "    ")

manifest = {
    "name": name,
    "version": ver,
    "language": lang,
    "entry_point": entry,
    "author": data.get("author_name", "Community"),
    "description": data.get("description", ""),
    "dependencies": data.get("dependencies", {})
}

target_dir = os.path.abspath(f"modules/{name}")
global_dir = os.path.expanduser(f"~/.smiledev/modules/{name}")

if not payload:
    try:
        import urllib.request
        req = urllib.request.Request(f"https://repo.cokistudios.com/modules/{name}/code", headers={"User-Agent": "smiledev/2.8.0 (Coki Studios)"})
        with urllib.request.urlopen(req, timeout=8) as r:
            payload = r.read().decode("utf-8")
    except Exception:
        pass

for base_dir in [target_dir, global_dir]:
    os.makedirs(base_dir, exist_ok=True)
    with open(os.path.join(base_dir, "smile.json"), "w") as mf:
        json.dump(manifest, mf, indent=2)
    if payload:
        with open(os.path.join(base_dir, entry), "w") as ef:
            ef.write(payload)

print(f"  ✔ Manifest saved to: {target_dir}/smile.json")
print(f"  ✔ Code entry point:  {target_dir}/{entry}")
'

    # Increment download counter in Supabase asynchronously
    (curl -s -X PATCH -H "apikey: $SUPABASE_KEY" \
         -H "Authorization: Bearer $SUPABASE_KEY" \
         -H "Content-Type: application/json" \
         -d '{"updated_at": "'"$(date -u +"%Y-%m-%dT%H:%M:%SZ")"'"}' \
         "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name" > /dev/null 2>&1 || true) &

    # Update local project smile.json dependencies if present
    if [ -f "./smile.json" ]; then
        python3 -c "
import json
try:
    with open('./smile.json', 'r') as f:
        d = json.load(f)
    if 'dependencies' not in d:
        d['dependencies'] = {}
    d['dependencies']['$mod_name'] = '^1.0.0'
    with open('./smile.json', 'w') as f:
        json.dump(d, f, indent=2)
    print('  ✔ Added to local smile.json dependencies')
except Exception:
    pass
" 2>/dev/null || true
    fi

    echo -e "${C_GREEN}✔ [SUCCESS]${C_RESET} Module ${C_BOLD}$mod_name${C_RESET} installed at:"
    echo -e "   • Local:  ${C_AQUA}$target_dir${C_RESET}"
    echo -e "   • Global: ${C_AQUA}$GLOBAL_MODULES_DIR/$mod_name${C_RESET}"
    echo -e "   • Ready to import in Looping with: ${C_YELLOW}use module \"$mod_name\"${C_RESET} or ${C_YELLOW}import \"$mod_name\"${C_RESET}"
}

# ── 3. COMMAND: UNINSTALL / REMOVE ──
cmd_uninstall() {
    local mod_name="$1"
    local global_flag=false
    shift || true
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --global|-g) global_flag=true ;;
        esac
        shift || true
    done

    if [ -z "$mod_name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Specify module name to remove. Example: ${C_CYAN}smiledev remove loop-core-utils${C_RESET}"
        exit 1
    fi

    local removed=0
    if [ -d "$LOCAL_MODULES_DIR/$mod_name" ]; then
        rm -rf "$LOCAL_MODULES_DIR/$mod_name"
        echo -e "  ${C_GREEN}✔${C_RESET} Removed local module: ${C_AQUA}$LOCAL_MODULES_DIR/$mod_name${C_RESET}"
        removed=1
    fi

    if [ "$global_flag" = true ] && [ -d "$GLOBAL_MODULES_DIR/$mod_name" ]; then
        rm -rf "$GLOBAL_MODULES_DIR/$mod_name"
        echo -e "  ${C_GREEN}✔${C_RESET} Removed global module: ${C_AQUA}$GLOBAL_MODULES_DIR/$mod_name${C_RESET}"
        removed=1
    fi

    if [ -f "./smile.json" ]; then
        python3 -c "
import json
try:
    with open('./smile.json', 'r') as f:
        d = json.load(f)
    if 'dependencies' in d and '$mod_name' in d['dependencies']:
        del d['dependencies']['$mod_name']
        with open('./smile.json', 'w') as f:
            json.dump(d, f, indent=2)
        print('  ✔ Removed from local smile.json dependencies')
except Exception:
    pass
" 2>/dev/null || true
    fi

    if [ "$removed" -eq 1 ]; then
        echo -e "${C_GREEN}✔ [UNINSTALLED]${C_RESET} Module ${C_BOLD}$mod_name${C_RESET} successfully removed."
    else
        echo -e "${C_YELLOW}⚠ Module '$mod_name' was not found in ./modules.${C_RESET} (Pass --global to remove from global cache)"
    fi
}

# ── 4. COMMAND: UPDATE ──
cmd_update() {
    local target="$1"
    if [ "$target" == "--self" ]; then
        cmd_upgrade "$@"
        return 0
    fi

    if [ -n "$target" ] && [ "$target" != "--all" ]; then
        echo -e "${C_CYAN}⚡ Updating module:${C_RESET} ${C_BOLD}$target${C_RESET}..."
        cmd_install "$target"
        return 0
    fi

    if [ -d "$LOCAL_MODULES_DIR" ] && [ "$(ls -A "$LOCAL_MODULES_DIR" 2>/dev/null)" ]; then
        echo -e "${C_CYAN}⚡ smiledev update:${C_RESET} Refreshing all local modules..."
        for d in "$LOCAL_MODULES_DIR"/*; do
            if [ -d "$d" ]; then
                local bname=$(basename "$d")
                echo -e "\n• Checking update for: ${C_BOLD}$bname${C_RESET}"
                cmd_install "$bname" || true
            fi
        done
        echo -e "\n${C_GREEN}✔ [SUCCESS]${C_RESET} All local modules updated."
    else
        echo -e "${C_YELLOW}No local modules found in ./modules to update.${C_RESET}"
    fi
}

