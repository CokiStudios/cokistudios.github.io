    local local_manifest="$LOCAL_MODULES_DIR/$mod_name/smile.json"
    local global_manifest="$GLOBAL_MODULES_DIR/$mod_name/smile.json"
    local local_found=false

    if [ -f "$local_manifest" ] || [ -f "$global_manifest" ]; then
        local_found=true
        local target_mf="$local_manifest"
        local source_type="Local (./modules)"
        if [ ! -f "$local_manifest" ]; then
            target_mf="$global_manifest"
            source_type="Global (~/.smiledev/modules)"
