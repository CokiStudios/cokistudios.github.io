<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header with CS logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_pill"
            android:gravity="center"
            android:text="CS"
            android:textColor="@color/cyan_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coki Studios ID"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuenta universal Shine Maps"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCsidClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Tab Selector (Iniciar Sesión / Registrarse) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="20dp"
        android:background="#0f172a"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabLogin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_pill"
            android:gravity="center"
            android:text="Iniciar Sesión"
            android:textColor="@color/cyan_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabRegister"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Crear CS ID"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Name input (Register only) -->
    <EditText
        android:id="@+id/etCsidName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Nombre completo"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_sub"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Email input -->
    <EditText
        android:id="@+id/etCsidEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Correo electrónico"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_sub"
        android:textSize="14sp" />

    <!-- Password input -->
    <EditText
        android:id="@+id/etCsidPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:hint="Contraseña"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_sub"
        android:textSize="14sp" />

    <!-- Error message -->
    <TextView
        android:id="@+id/tvCsidError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/rose_accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Action Button -->
    <Button
        android:id="@+id/btnCsidSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Acceder con CS ID"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/pbCsidLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

</LinearLayout>
