<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 100% Native OpenGL MapLibre MapView -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_uiAttribution="false"
        app:maplibre_uiCompass="false"
        app:maplibre_uiLogo="false" />

    <!-- FLOATING TOP BAR & SEARCH -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp">

        <!-- Search & Brand Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar destino, dirección..."
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Limpiar"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Buscar"
                android:padding="8dp"
                android:src="@drawable/ic_search" />

            <TextView
                android:id="@+id/tvCsIdBadge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="CS"
                android:textColor="@color/cyan_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Suggestions Dropdown (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_glass"
            android:maxHeight="240dp"
            android:visibility="gone" />

        <!-- Quick Destinations Horizontal Scroll -->
        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHome"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:drawableStart="@drawable/ic_home"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="Casa"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipWork"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:drawableStart="@drawable/ic_work"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="Estudio"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipSaveCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_pill"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:text="Guardar"
                    android:textColor="@color/cyan_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- RIGHT FLOATING CONTROL STACK -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnMyLocation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_control_circle"
            android:contentDescription="Mi Ubicación GPS"
            android:padding="12dp"
            android:src="@drawable/ic_my_location" />

        <ImageButton
            android:id="@+id/btnLayers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_control_circle"
            android:contentDescription="Cambiar Capa"
            android:padding="12dp"
            android:src="@drawable/ic_layers" />

        <ImageButton
            android:id="@+id/btnHud"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_control_circle"
            android:contentDescription="Modo HUD In-Car"
            android:padding="12dp"
            android:src="@drawable/ic_hud" />
    </LinearLayout>

    <!-- BOTTOM-LEFT FLOATING SPEEDOMETER -->
    <LinearLayout
        android:id="@+id/cardSpeedometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_card_glass"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvSpeedVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/cyan_accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="km/h"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION ACTIVE ROUTE PANEL -->
    <LinearLayout
        android:id="@+id/cardNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_glass"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRouteManeuverIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Maniobra"
                android:src="@drawable/ic_turn_straight" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continúa recto"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRouteStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- km • -- min"
                    android:textColor="@color/cyan_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnCloseNav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar Ruta"
                android:padding="6dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- FULLSCREEN IN-CAR HUD MODE OVERLAY -->
    <RelativeLayout
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hud_bg"
        android:keepScreenOn="true"
        android:visibility="gone">

        <!-- Top Controls: Mirror & Exit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:padding="24dp">

            <Button
                android:id="@+id/btnHudMirror"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/surface_dark"
                android:text="Modo Espejo"
                android:textColor="@color/cyan_primary"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCloseHud"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/rose_accent"
                android:text="Salir HUD"
                android:textColor="#ffffff"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Center Large Speedometer Display -->
        <LinearLayout
            android:id="@+id/hudCenterBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hudSpeedNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/hud_accent"
                android:textSize="120sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="KM/H • SHINE HUD"
                android:textColor="@color/text_sub"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Upcoming Turn Instruction -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/hudNextInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continúa por la vía principal"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hudNextDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="En 450 m"
                android:textColor="@color/cyan_primary"
                android:textSize="18sp" />
        </LinearLayout>

    </RelativeLayout>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
