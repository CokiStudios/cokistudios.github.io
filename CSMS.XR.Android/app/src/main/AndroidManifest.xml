<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android XR required permissions -->
    <uses-permission android:name="android.permission.XR_SCENE" />
    <uses-feature
        android:name="android.hardware.xr"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Launcha como app XR inmersiva en headsets Android XR -->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.XR_IMMERSIVE_HMD" />
            </intent-filter>
        </activity>

    </application>

</manifest>
