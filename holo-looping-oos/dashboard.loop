# ═══════════════════════════════════════════════════════════════
# [HOLO LOOPING OoS] Shine Poortloop System Dashboard v2.0
# Hardware: Shine Poortloop (Portable Handheld Gaming Console)
# Sub-division of Holo Entertainment by Coki Studios (Pages 9 & 11)
# ═══════════════════════════════════════════════════════════════

import loop.ui as ui
import loop.engine as game

define app "ShinePoortloopHome" version 2.0:
    create window with title "Shine Poortloop -- Holo Looping OoS" and size (720, 480)
    set theme to "frosted_aqua_a17"
    
    set console_model to "Shine Poortloop (Handheld Gaming Console)"
    set kernel_version to "Holo Looping OoS 1.0 (Low-Latency Linux Core)"
    set battery_level to "94% [Battery Powered]"
    set active_player to "Angel Helium"
    
    print "[BOOT] Starting Shine Poortloop Gaming Subsystem..."
    print "[HARDWARE] Form Factor: Handheld Console (Steam Deck Style)"
    print "[INPUT] Controller: Integrated Shine Poortloop Keypad (P1/P2, Z1/Z2, D-Pad)"
    print "[PLAYER] Active:", active_player
    
    # ── Console Top Bar (Battery, Gamepad, Kernel Status) ──
    draw card at (30, 25) with size (660, 60) and title "SHINE POORTLOOP // HOLO ENTERTAINMENT" and text "Kernel: Holo Looping OoS 1.0 | Display: 60Hz Direct V-Sync | Battery: 94%"

    # ── Loop OS Home Game Carousel (Design Guide p.9) ──
    draw card at (30, 100) with size (315, 175) and title "[GAME 01] Holo Arcade 2D" and text "Genre: 2D Cyber Platformer\nEngine: Looping Compile v2.0\nStatus: Ready to Launch"
    draw button at (50, 215) with text "PLAY [A]" and action "launch_arcade"

    draw card at (375, 100) with size (315, 175) and title "[GAME 02] Forkar Arena" and text "Genre: Arena Action\nEngine: Looping 60Hz Subsystem\nStatus: Installed on NVMe"
    draw button at (395, 215) with text "PLAY [A]" and action "launch_forkar"

    # ── Poortloop Hardware Telemetry (Pure Gaming Console Specs) ──
    draw card at (30, 290) with size (660, 125) and title "SHINE POORTLOOP HARDWARE TELEMETRY" and text "APU: Quad-Core Low Latency | GPU: Vulkan Native Driver | RAM: 4GB LPDDR5\nControls: Dual Analog, D-Pad, P1/P2 Grip Buttons, Z1/Z2 Triggers\nStorage: 64GB Internal Fast NVMe | Optical: Shine Loop Blu-disk Slot"

    # ── Hardware Chime on Boot ──
    play tone at 587 Hz for 80 ms

    print "[READY] Shine Poortloop Home ready for gamepad input."
