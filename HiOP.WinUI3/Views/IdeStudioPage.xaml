<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HiOP.WinUI3.Views.IdeStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HiOP.WinUI3.Models">

    <Grid RowDefinitions="Auto,*,Auto" Background="Transparent">

        <!-- 1. IDE Action Toolbar -->
        <Border Grid.Row="0" Background="#B00B111E" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click" ToolTipService.ToolTip="Alternar Explorador">
                        <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                    </Button>

                    <DropDownButton Content="+ Nuevo (.loop)">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="NewTemplateMenuFlyout" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="BtnOpenFile_Click" ToolTipService.ToolTip="Abrir archivo del equipo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <TextBlock Text="Abrir" />
                        </StackPanel>
                    </Button>

                    <Button Click="BtnSaveFile_Click" ToolTipService.ToolTip="Guardar archivo activo (Ctrl+S)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                            <TextBlock Text="Guardar" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <ComboBox x:Name="TargetCombo" SelectedIndex="0" Width="210" VerticalAlignment="Center">
                        <ComboBoxItem Content="Looping Native / Auto" />
                        <ComboBoxItem Content="Quantum 3D + loopize++" />
                        <ComboBoxItem Content="Shine Loop (Holo OS)" />
                        <ComboBoxItem Content="SwiftUI / C2 Transpiler" />
                        <ComboBoxItem Content="Node.js Runtime" />
                    </ComboBox>

                    <Button x:Name="BtnRunNative" Click="BtnRunNative_Click" Background="#00F5D4" Foreground="#030508" FontWeight="Bold" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="Ejecutar (F5)" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStopRun" Click="BtnStopRun_Click" ToolTipService.ToolTip="Detener ejecución" IsEnabled="False">
                        <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="#F43F5E" />
                    </Button>

                    <Button Click="BtnRunStage3D_Click" Background="#162544" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF158;" FontSize="13" Foreground="#38BDF8" />
                            <TextBlock Text="Stage 3D Live" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <Button Click="BtnCheck_Click" ToolTipService.ToolTip="Verificación estática">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" />
                            <TextBlock Text="Check" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnAst_Click" ToolTipService.ToolTip="Inspeccionar AST">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="#C084FC" />
                            <TextBlock Text="AST" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnFmt_Click" ToolTipService.ToolTip="Formatear código (.loop)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="#FBBF24" />
                            <TextBlock Text="FMT" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnInvis_Click" ToolTipService.ToolTip="Invis. Compile (LPBN v3.0A)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE7B8;" FontSize="13" Foreground="#38BDF8" />
                            <TextBlock Text="Invis LPBN" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnToggleTerminal_Click" ToolTipService.ToolTip="Alternar Consola">
                        <FontIcon Glyph="&#xE756;" FontSize="13" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 2. Main Split Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Explorer + Quick Arch 3.0A Presets -->
            <Border x:Name="ExplorerPane" Grid.Column="0" Background="#90080E1A" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="#00F5D4" />
                            <TextBlock Text="EXPLORADOR" FontWeight="Bold" FontSize="11" CharacterSpacing="60" Foreground="#CBD5E1" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="BtnRefreshTree_Click" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Recargar árbol">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" Click="BtnOpenSmiledev_Click" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Instalar paquetes Smiledev">
                            <FontIcon Glyph="&#xE7B8;" FontSize="12" Foreground="#38BDF8" />
                        </Button>
                    </Grid>

                    <TreeView
                        x:Name="WorkspaceTree"
                        Grid.Row="1"
                        SelectionMode="Single"
                        ItemInvoked="WorkspaceTree_ItemInvoked"
                        Padding="4,0">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="False">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="2,3" ColumnSpacing="8">
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind AccentBrush}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind BadgeText}" FontSize="9" Foreground="#64748B" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Border Grid.Row="2" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8" Background="#50050912">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="WorkspacePathLabel" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                            <Button Content="📦 Ir a Smiledev Package Manager" HorizontalAlignment="Stretch" FontSize="11" Click="BtnOpenSmiledev_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Center Editor Area -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto">
                    <!-- Open File Tabs Strip -->
                    <Border Grid.Row="0" Background="#A0070C17" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="TabsStrip" Orientation="Horizontal" Spacing="4" />
                        </ScrollViewer>
                    </Border>

                    <!-- Monospace Code Editor with synchronized scrolling -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid ColumnDefinitions="50,*">
                            <Border Grid.Column="0" Background="#80060A14">
                                <TextBlock
                                    x:Name="LineNumbersText"
                                    Padding="8,11,8,14"
                                    TextAlignment="Right"
                                    FontFamily="Cascadia Code, Consolas, Courier New"
                                    FontSize="13.5"
                                    LineHeight="19"
                                    Foreground="#475569"
                                    Text="1" />
                            </Border>

                            <TextBox
                                x:Name="CodeEditorBox"
                                Grid.Column="1"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Cascadia Code, Consolas, Courier New"
                                FontSize="13.5"
                                Padding="14,10,14,14"
                                Background="#B804070E"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                TextChanged="CodeEditorBox_TextChanged"
                                KeyDown="CodeEditorBox_KeyDown" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Mini Editor Meta Bar -->
                    <Border Grid.Row="2" Background="#A0070C17" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ActiveFileInfoText" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EditorStatsText" Grid.Column="1" FontSize="11" Foreground="#00F5D4" FontFamily="Consolas" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Terminal Drawer -->
                <Border x:Name="TerminalDrawer" Grid.Row="1" Height="195" Background="#E0050811" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Background="#800B111E" Padding="12,6" ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="#38BDF8" />
                                <TextBlock Text="CONSOLA DE EJECUCIÓN LOOPING (ARCH 3.0A)" FontSize="11" FontWeight="Bold" Foreground="#CBD5E1" />
                                <TextBlock x:Name="ExecutionStatusBadge" FontSize="11" Foreground="#00F5D4" FontFamily="Consolas" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Limpiar" FontSize="11" Padding="8,2" Margin="0,0,6,0" Click="BtnClearTerminal_Click" />
                            <Button Grid.Column="2" Content="Ocultar" FontSize="11" Padding="8,2" Click="BtnToggleTerminal_Click" />
                        </Grid>

                        <ScrollViewer x:Name="TerminalScroll" Grid.Row="1" Padding="12,8">
                            <TextBox
                                x:Name="TerminalOutputBox"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent"
                                FontFamily="Cascadia Code, Consolas"
                                FontSize="12"
                                Foreground="#E2E8F0" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Inspector Panel (AST / Diagnostics / SwiftUI & Polyglot) -->
            <Border x:Name="InspectorPane" Grid.Column="2" Background="#90080E1A" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="#C084FC" />
                            <TextBlock Text="INSPECTOR ARCH 3.0A" FontWeight="Bold" FontSize="11" CharacterSpacing="60" Foreground="#CBD5E1" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="BtnRefreshInspector_Click" Padding="6,4" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="10,4,10,12">
                        <StackPanel Spacing="12">
                            <Border Background="#7011192B" CornerRadius="8" Padding="10" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Árbol Sintáctico (AST)" FontWeight="SemiBold" FontSize="12" Foreground="#C084FC" />
                                    <TextBlock x:Name="AstSummaryText" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#7011192B" CornerRadius="8" Padding="10" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Diagnósticos (Check)" FontWeight="SemiBold" FontSize="12" Foreground="#10B981" />
                                    <TextBlock x:Name="CheckSummaryText" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#7011192B" CornerRadius="8" Padding="10" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Puentes Políglotas &amp; UI" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                                    <TextBlock x:Name="PolyglotSummaryText" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Strip -->
        <Border Grid.Row="2" Background="#070B14" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusFooterLeft" FontSize="11" Foreground="#94A3B8" Text="Looping Engine Arch 3.0A listo." />
                <TextBlock x:Name="StatusFooterRight" Grid.Column="1" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Page>
