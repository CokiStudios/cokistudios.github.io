<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HiOP.WinUI3.Views.QuantumStagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*" Background="Transparent">
        <!-- Stage Top Header -->
        <Border Grid.Row="0" Background="#B00B111E" BorderBrush="{StaticResource CsBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xF158;" Foreground="#00F5D4" FontSize="18" />
                    <StackPanel>
                        <TextBlock Text="Quantum 3D &amp; 2D Live Stage (Looping Core + .OBJ + C#)" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="StageSubtitleText" Text="WebView2 Engine con física 120Hz, Wavefront .OBJ y loopize++" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="StagePresetCombo" Width="260" SelectionChanged="StagePresetCombo_SelectionChanged" />
                    <Button Click="BtnRunCurrent_Click" Background="#00F5D4" Foreground="#030508" FontWeight="Bold">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="Ejecutar en Stage" />
                        </StackPanel>
                    </Button>
                    <Button Click="BtnStopStage_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE71A;" FontSize="13" Foreground="#F43F5E" />
                            <TextBlock Text="Detener" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Embedded WebView2 Canvas Viewport -->
        <WebView2 x:Name="StageWebView" Grid.Row="1" />
    </Grid>
</Page>
