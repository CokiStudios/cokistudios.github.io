<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HiOP.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="hiOP Studio — Looping Arch 3.0A">

    <Grid RowDefinitions="46,*" Background="#C8030508">
        <!-- Custom Extended WinUI 3 TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
            <Image Source="ms-appx:///Assets/hiop-icon.png" Width="22" Height="22" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="hiOP Studio" FontWeight="Bold" FontSize="13.5" />
                <Border Background="#2000F5D4" BorderBrush="#5000F5D4" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                    <TextBlock Text="WinUI 3 NATIVE" FontSize="9.5" FontWeight="Bold" Foreground="#00F5D4" FontFamily="Consolas" />
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Background="#1C192E" BorderBrush="#40C084FC" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleChannelPill" Text="Looping v1.1 • Arch 3.0A" FontSize="10.5" Foreground="#C084FC" FontFamily="Consolas" />
            </Border>

            <Button
                x:Name="TitleUpdatePillBtn"
                Grid.Column="4"
                Visibility="Collapsed"
                Click="TitleUpdatePillBtn_Click"
                Padding="10,3"
                CornerRadius="999"
                Background="#2010B981"
                BorderBrush="#6010B981"
                Foreground="#10B981"
                FontSize="11"
                Content="⬇ Actualización disponible"
                VerticalAlignment="Center" />

            <Border Grid.Column="5" Background="#1838BDF8" CornerRadius="6" Padding="8,2" Margin="0,0,136,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleCsIdText" Text="CS ID: Invitado" FontSize="10.5" Foreground="#38BDF8" FontFamily="Consolas" />
            </Border>
        </Grid>

        <!-- Root NavigationView -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="210"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="IDE Studio" Tag="ide">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Quantum 3D Stage" Tag="stage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF158;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Toolchain 3.0A" Tag="toolchain">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Smiledev &amp; Paquetes" Tag="smiledev">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Actualizaciones" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdatesNavBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
