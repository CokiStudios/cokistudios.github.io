<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HiOP.WinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#00F5D4</Color>
            <SolidColorBrush x:Key="CsBgRootBrush" Color="#030508" />
            <SolidColorBrush x:Key="CsBgSurfaceBrush" Color="#0B111E" />
            <SolidColorBrush x:Key="CsBgCardBrush" Color="#11192B" />
            <SolidColorBrush x:Key="CsBorderBrush" Color="#24324B" />
            <SolidColorBrush x:Key="CsAquaBrush" Color="#00F5D4" />
            <SolidColorBrush x:Key="CsCyanBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="CsPurpleBrush" Color="#C084FC" />
            <SolidColorBrush x:Key="CsAmberBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="CsRoseBrush" Color="#F43F5E" />
            <SolidColorBrush x:Key="CsGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="CsTextMutedBrush" Color="#94A3B8" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
