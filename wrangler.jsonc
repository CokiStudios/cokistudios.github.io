{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cokistudios-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/apt/*",
      "!/debian/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    "cokistudios.com/*",
    "www.cokistudios.com/*",
    "repo.cokistudios.com/*",
    "developer.cokistudios.com/*",
    {
      "pattern": "docs.cokistudios.com",
      "custom_domain": true
    },
    "cdn.cokistudios.com/*",
    "mdm.cokistudios.com/*"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
