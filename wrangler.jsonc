{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cokistudios-github-io",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    "cokistudios.com/*",
    "www.cokistudios.com/*"
  ]
}
