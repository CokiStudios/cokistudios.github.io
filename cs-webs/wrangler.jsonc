{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-webs",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  "kv_namespaces": [
    {
      "binding": "CS_WEBS_STORAGE",
      "id": "41ad606d74e44a22a57d8ee294938391"
    }
  ],
  "routes": [
    {
      "pattern": "webs.cokistudios.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
