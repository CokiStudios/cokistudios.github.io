#!/usr/bin/env zsh
# CS WEBS — Control CLI Daemon for Coki Studios Web Enterprise & Business Server
# Zero Node.js • Zero Containers • Native zsh/Python

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
SERVER_PY="$PROJECT_ROOT/cs-webs/server.py"
PID_FILE="$PROJECT_ROOT/cs-webs/cs-webs.pid"
LOG_FILE="$PROJECT_ROOT/cs-webs/cs-webs.log"
PORT=8080

print_cyan() { echo "\033[1;36m$1\033[0m"; }
print_green() { echo "\033[1;32m$1\033[0m"; }
print_yellow() { echo "\033[1;33m$1\033[0m"; }
print_red() { echo "\033[1;31m$1\033[0m"; }

case "$1" in
    start)
        if [[ -f "$PID_FILE" ]] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            print_yellow "⚠️ CS WEBS is already running (PID: $(cat "$PID_FILE"))"
            exit 0
        fi

        if [[ "$2" == "--port" && -n "$3" ]]; then
            PORT="$3"
        fi

        print_cyan "🚀 Starting CS WEBS (Coki Studios Web Enterprise & Business Server) on port $PORT..."
        python3 "$SERVER_PY" --port "$PORT" > "$LOG_FILE" 2>&1 &
        SERVER_PID=$!
        echo "$SERVER_PID" > "$PID_FILE"
        sleep 1

        if kill -0 "$SERVER_PID" 2>/dev/null; then
            print_green "✔ CS WEBS started successfully! [PID: $SERVER_PID]"
            print_cyan "  • Admin Console: http://localhost:$PORT/"
            print_cyan "  • API Health:    http://localhost:$PORT/api/v1/health"
            print_cyan "  • .c2 Repo:      http://localhost:$PORT/api/v1/c2/modules"
        else
            print_red "❌ Failed to start CS WEBS. Check $LOG_FILE"
            exit 1
        fi
        ;;

    stop)
        if [[ -f "$PID_FILE" ]]; then
            TARGET_PID=$(cat "$PID_FILE")
            print_yellow "🛑 Stopping CS WEBS (PID: $TARGET_PID)..."
            kill "$TARGET_PID" 2>/dev/null
            rm -f "$PID_FILE"
            print_green "✔ CS WEBS stopped."
        else
            print_yellow "⚠️ CS WEBS is not currently running."
        fi
        ;;

    status)
        if [[ -f "$PID_FILE" ]] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            print_green "✔ CS WEBS is ACTIVE and RUNNING (PID: $(cat "$PID_FILE"))"
            curl -s "http://localhost:$PORT/api/v1/health" | python3 -m json.tool 2>/dev/null || echo "Responding at http://localhost:$PORT/"
        else
            print_yellow "○ CS WEBS is STOPPED."
            rm -f "$PID_FILE" 2>/dev/null
        fi
        ;;

    restart)
        "$0" stop
        sleep 1
        "$0" start "$@"
        ;;

    logs)
        if [[ -f "$LOG_FILE" ]]; then
            tail -f "$LOG_FILE"
        else
            print_yellow "No log file found at $LOG_FILE"
        fi
        ;;

    *)
        echo "Usage: cs-webs {start|stop|restart|status|logs} [--port <port>]"
        exit 1
        ;;
esac
