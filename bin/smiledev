    echo -e "${C_CYAN}|_____/|_| |_| |_|_|_|\___${C_PURPLE}|____/ \___| \_/  ${C_DIM}(Looping Package Manager)${C_RESET}"
    echo ""
}

cmd_help() {
    print_banner
    echo -e "${C_BOLD}USO:${C_RESET} smiledev <comando> [argumentos]"
