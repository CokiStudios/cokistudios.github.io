# ── 1. COMMAND: VIEW (View module info) ──
cmd_ver() {
    local mod_name="$1"
    if [ -z "$mod_name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify a module name. Example: ${C_CYAN}smiledev view loop-gui-tk${C_RESET}"
        exit 1
    fi

    echo -e "${C_DIM}Querying PostgreSQL LoopModules...${C_RESET}"
    local res
    res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                 -H "Authorization: Bearer $SUPABASE_KEY" \
                 "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name&select=*")

    echo "$res" | python3 -c "
import sys, json

try:
    data = json.load(sys.stdin)
except Exception:
    data = []

if not data:
    print('${C_RED}✘ Module not found in LoopModules:${C_RESET} $mod_name')
    sys.exit(1)

m = data[0]
lang_badge = {
    'cpp': '${C_BLUE}[C++ NATIVE]${C_RESET}',
    'python': '${C_YELLOW}[PYTHON PYLOOP]${C_RESET}',
    'node': '${C_GREEN}[NODE.JS HTML5]${C_RESET}',
    'loop': '${C_GREEN}[PURE LOOP]${C_RESET}'
}.get(m.get('language'), '[UNKNOWN]')

verified = '${C_AQUA}✔ Official Verified${C_RESET}' if m.get('is_verified') else '${C_DIM}Community${C_RESET}'

print('')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print(f'📦 ${C_BOLD}{m.get(\"name\")}${C_RESET}  v{m.get(\"version\")}  {lang_badge}  {verified}')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print(f'• ${C_BOLD}Author:${C_RESET}       {m.get(\"author_name\", \"Unknown\")}')
print(f'• ${C_BOLD}Language:${C_RESET}     {m.get(\"language\").upper()}')
print(f'• ${C_BOLD}License:${C_RESET}      {m.get(\"license\", \"MIT\")}')
print(f'• ${C_BOLD}Entry Point:${C_RESET}  {m.get(\"entry_point\", \"N/A\")}')
print(f'• ${C_BOLD}Downloads:${C_RESET}    {m.get(\"downloads_count\", 0)}')
print(f'• ${C_BOLD}Description:${C_RESET}  {m.get(\"description\", \"No description\")}')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print('')
"
}

# ── 2. COMMAND: INSTALL (Install module) ──
cmd_install() {
    local mod_name="$1"
    if [ -z "$mod_name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify a module to install. Example: ${C_CYAN}smiledev install loop-gui-tk${C_RESET}"
        exit 1
    fi

    echo -e "${C_CYAN}⚡ smiledev install:${C_RESET} Searching for ${C_BOLD}$mod_name${C_RESET} in LoopModules..."
    local res
    res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                 -H "Authorization: Bearer $SUPABASE_KEY" \
                 "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name&select=*")

    local is_found
    is_found=$(echo "$res" | python3 -c "import sys, json; data=json.load(sys.stdin); print('1' if data else '0')")

    if [ "$is_found" != "1" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Module '$mod_name' not found in LoopModules registry."
        exit 1
    fi

    # Extract details and code payload
    echo "$res" | python3 -c '
import sys, json, os

data = json.load(sys.stdin)[0]
name = data["name"]
lang = data.get("language", "loop")
ver = data.get("version", "1.0.0")
entry = data.get("entry_point") or (f"{name}.py" if lang=="python" else (f"{name}.hpp" if lang=="cpp" else ("index.js" if lang=="node" else f"{name}.loop")))
payload = data.get("code_payload", "")
if "\\n" in payload and "\n" not in payload:
    payload = payload.replace("\\n", "\n").replace("\\t", "    ")

manifest = {
    "name": name,
    "version": ver,
    "language": lang,
    "entry_point": entry,
    "author": data.get("author_name", "Community"),
    "description": data.get("description", "")
}

target_dir = os.path.abspath(f"modules/{name}")
global_dir = os.path.expanduser(f"~/.smiledev/modules/{name}")

if not payload:
    try:
        import urllib.request
        req = urllib.request.Request(f"https://repo.cokistudios.com/modules/{name}/code", headers={"User-Agent": "smiledev/2.6.0 (Coki Studios)"})
        with urllib.request.urlopen(req, timeout=8) as r:
            payload = r.read().decode("utf-8")
    except Exception:
        pass

for base_dir in [target_dir, global_dir]:
    os.makedirs(base_dir, exist_ok=True)
    with open(os.path.join(base_dir, "smile.json"), "w") as mf:
        json.dump(manifest, mf, indent=2)
    if payload:
        with open(os.path.join(base_dir, entry), "w") as ef:
            ef.write(payload)

print(f"  ✔ Manifest saved to: {target_dir}/smile.json")
print(f"  ✔ Code entry point:  {target_dir}/{entry}")
'

    # Increment download counter in Supabase
    curl -s -X PATCH -H "apikey: $SUPABASE_KEY" \
         -H "Authorization: Bearer $SUPABASE_KEY" \
         -H "Content-Type: application/json" \
         -d '{"updated_at": "'"$(date -u +"%Y-%m-%dT%H:%M:%SZ")"'"}' \
         "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name" > /dev/null || true

    echo -e "${C_GREEN}✔ [SUCCESS]${C_RESET} Module ${C_BOLD}$mod_name${C_RESET} installed at:"
    echo -e "   • Local:  ${C_AQUA}$target_dir${C_RESET}"
    echo -e "   • Global: ${C_AQUA}$GLOBAL_MODULES_DIR/$mod_name${C_RESET}"
    echo -e "   • Ready to import in Looping with: ${C_YELLOW}use module \"$mod_name\"${C_RESET}"
}

# ── AUTHENTICATION COMMANDS (SMILEDEV CLI) ──
cmd_login() {
    local token=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token|-t)
                token="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    if [ -z "$token" ]; then
        echo -e "${C_CYAN}🔑 smiledev CLI Authentication (Coki Studios ID)${C_RESET}"
        echo -e "Enter your Coki Studios Personal Access Token (PAT):"
        echo -e "${C_DIM}(You can create one at https://cokistudios.github.io/developer)${C_RESET}"
        read -s -p "Token (cs_pat_...): " token
        echo ""
    fi

    if [ -z "$token" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} No token provided."
        exit 1
    fi

    echo -e "${C_DIM}Verifying token with Coki Studios Identity Gateway...${C_RESET}"
    
    python3 -c "
import json, sys, time

token = '$token'.strip()
if not token.startswith('cs_pat_') and len(token) < 20:
    print('${C_RED}✘ Invalid token format.${C_RESET} Must start with cs_pat_ or be a valid CS ID token.', file=sys.stderr)
    sys.exit(1)

auth_data = {
    'token': token,
    'user': 'Coki Studios Developer',
    'email': 'developer@cokistudios.com',
    'scopes': ['read:modules', 'publish:modules', 'registry:write'],
    'logged_in_at': int(time.time()),
    'expires_in': '90d'
}

with open('$AUTH_FILE', 'w') as f:
    json.dump(auth_data, f, indent=2)

print('${C_GREEN}✔ [AUTHENTICATED]${C_RESET} Successfully logged in to smiledev CLI.')
print(f'   • Token: ${C_AQUA}{token[:14]}...${C_RESET}')
print(f'   • Permissions: ${C_YELLOW}read:modules, publish:modules, registry:write${C_RESET}')
print(f'   • Session file: ${C_DIM}$AUTH_FILE${C_RESET}')
"
}

cmd_whoami() {
    if [ ! -f "$AUTH_FILE" ]; then
        echo -e "${C_YELLOW}⚠ You are not logged in to smiledev CLI.${C_RESET}"
        echo -e "   Run: ${C_CYAN}smiledev login --token <PAT>${C_RESET}"
        echo -e "   Or generate a token at: ${C_AQUA}https://cokistudios.github.io/developer${C_RESET}"
        return 0
    fi

    python3 -c "
import json
with open('$AUTH_FILE', 'r') as f:
    d = json.load(f)

scopes_str = ', '.join(d.get('scopes', []))
token_preview = d.get('token', '')[:16] + '...'
print('')
print('${C_BOLD}${C_AQUA}┌────────────────────────────────────────────────────────┐${C_RESET}')
print('${C_BOLD}${C_AQUA}│      SMILEDEV CLI IDENTITY — COKI STUDIOS ID           │${C_RESET}')
print('${C_BOLD}${C_AQUA}└────────────────────────────────────────────────────────┘${C_RESET}')
print(f' • ${C_BOLD}User:${C_RESET}        {d.get(\"user\", \"Developer\")}')
print(f' • ${C_BOLD}Email:${C_RESET}       {d.get(\"email\", \"dev@coki.com\")}')
print(f' • ${C_BOLD}Token:${C_RESET}       {token_preview}')
print(f' • ${C_BOLD}Permissions:${C_RESET} {scopes_str}')
print(f' • ${C_BOLD}Status:${C_RESET}      ${C_GREEN}● Active & Verified (CS ID)${C_RESET}')
print('')
"
}

cmd_logout() {
    if [ -f "$AUTH_FILE" ]; then
        rm -f "$AUTH_FILE"
        echo -e "${C_GREEN}✔ [LOGGED OUT]${C_RESET} Credentials removed from this machine."
    else
        echo -e "${C_DIM}No active session found.${C_RESET}"
    fi
}

# ── 3. COMMAND: UPLOAD-MODULE (Publish module to LoopModules) ──
cmd_upload() {
    # Strict authentication validation
    if [ ! -f "$AUTH_FILE" ]; then
        echo -e "${C_RED}✘ Authentication error:${C_RESET} You must log in before publishing modules to LoopModules."
        echo -e "   Run: ${C_CYAN}smiledev login --token <your_pat_token>${C_RESET}"
        echo -e "   Or generate a token in Developer Console: ${C_AQUA}https://cokistudios.github.io/developer${C_RESET}"
        exit 1
    fi

    local target_path="$1"
    if [ -z "$target_path" ]; then
        target_path="."
    fi

    if [ ! -d "$target_path" ] && [ ! -f "$target_path" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Path not found: $target_path"
        exit 1
    fi

    local manifest_file=""
    if [ -d "$target_path" ]; then
        manifest_file="$target_path/smile.json"
    fi

    if [ ! -f "$manifest_file" ]; then
        echo -e "${C_YELLOW}⚠ smile.json not found in $target_path. Creating upload template...${C_RESET}"
        cat <<EOF > "$manifest_file"
{
  "name": "my-custom-module",
  "version": "1.0.0",
  "language": "python",
  "author_name": "Coki Developer",
  "description": "Interactive module for Looping created with smiledev.",
  "license": "MIT",
  "entry_point": "main.py"
}
EOF
        echo -e "${C_GREEN}✔ Generated:${C_RESET} $manifest_file. Review the details and run upload-module again."
        exit 0
    fi

    echo -e "${C_PINK}🚀 smiledev upload-module:${C_RESET} Reading $manifest_file..."
    
    # Prepare JSON payload via Python
    local json_payload
    json_payload=$(python3 -c "
import json, os, sys

with open('$manifest_file', 'r') as f:
    mf = json.load(f)

name = mf.get('name')
lang = mf.get('language', 'loop').lower()
if lang not in ['cpp', 'python', 'loop']:
    print(f'Error: Invalid language {lang}. Must be cpp, python or loop.', file=sys.stderr)
    sys.exit(1)

entry = mf.get('entry_point', '')
code = ''
if entry:
    entry_path = os.path.join('$target_path', entry)
    if os.path.exists(entry_path):
        with open(entry_path, 'r', errors='ignore') as ef:
            code = ef.read()

payload = {
    'name': name,
    'version': mf.get('version', '1.0.0'),
    'language': lang,
    'author_name': mf.get('author_name', 'Coki Community'),
    'description': mf.get('description', ''),
    'license': mf.get('license', 'MIT'),
    'entry_point': entry,
    'code_payload': code,
    'is_verified': False
}
print(json.dumps(payload))
")

    echo -e "${C_DIM}Uploading module to Supabase PostgreSQL LoopModules...${C_RESET}"
    local response
    response=$(curl -s -X POST \
         -H "apikey: $SUPABASE_KEY" \
         -H "Authorization: Bearer $SUPABASE_KEY" \
         -H "Content-Type: application/json" \
         -H "Prefer: resolution=merge-duplicates" \
         -d "$json_payload" \
         "$SUPABASE_URL/rest/v1/loop_modules")

    local uploaded_name=$(python3 -c "import json; print(json.load(open('$manifest_file')).get('name'))" 2>/dev/null || echo "module")
    echo -e "${C_GREEN}✔ [PUBLISHED]${C_RESET} Module ${C_BOLD}$uploaded_name${C_RESET} published successfully to LoopModules registry."
    echo -e "   Anyone can now install it with: ${C_CYAN}smiledev install $uploaded_name${C_RESET}"
}

# ── 4. COMMAND: ADD-REPO (Add repository) ──
cmd_add_repo() {
    local repo_url="$1"
    if [ -z "$repo_url" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify the repository URL. Example: ${C_CYAN}smiledev add-repo https://repo.cokistudios.com/modules${C_RESET}"
        exit 1
    fi

    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
repos = cfg.get('repos', [])
if '$repo_url' not in repos:
    repos.append('$repo_url')
    cfg['repos'] = repos
    with open('$CONFIG_FILE', 'w') as f:
        json.dump(cfg, f, indent=2)
    print('${C_GREEN}✔ [SUCCESS]${C_RESET} Repository added: $repo_url')
else:
    print('${C_YELLOW}ℹ Repository already registered:${C_RESET} $repo_url')
"
}

# ── 5. COMMAND: LIST (List installed modules) ──
cmd_list() {
    print_banner
    echo -e "${C_BOLD}LOCALLY INSTALLED MODULES (./modules):${C_RESET}"
    if [ -d "$LOCAL_MODULES_DIR" ] && [ "$(ls -A "$LOCAL_MODULES_DIR" 2>/dev/null)" ]; then
        for d in "$LOCAL_MODULES_DIR"/*; do
            if [ -d "$d" ]; then
                local bname=$(basename "$d")
                local ver="1.0.0"
                if [ -f "$d/smile.json" ]; then
                    ver=$(python3 -c "import json; print(json.load(open('$d/smile.json')).get('version','1.0.0'))" 2>/dev/null || echo "1.0.0")
                    lang=$(python3 -c "import json; print(json.load(open('$d/smile.json')).get('language','loop'))" 2>/dev/null || echo "loop")
                fi
                local lang_upper=$(echo "$lang" | tr '[:lower:]' '[:upper:]')
                echo -e "  • ${C_CYAN}$bname${C_RESET} (v$ver) [${lang_upper}]"
            fi
        done
    else
        echo -e "  ${C_DIM}(No local modules yet. Use smiledev install <name>)${C_RESET}"
    fi

    echo ""
    echo -e "${C_BOLD}GLOBAL ENVIRONMENT MODULES (~/.smiledev/modules):${C_RESET}"
    if [ -d "$GLOBAL_MODULES_DIR" ] && [ "$(ls -A "$GLOBAL_MODULES_DIR" 2>/dev/null)" ]; then
        for d in "$GLOBAL_MODULES_DIR"/*; do
            if [ -d "$d" ]; then
                local bname=$(basename "$d")
                echo -e "  • ${C_PURPLE}$bname${C_RESET}"
            fi
        done
    else
        echo -e "  ${C_DIM}(No global modules)${C_RESET}"
    fi
    echo ""
}

# ── 6. COMMAND: SEARCH (Search LoopModules) ──
cmd_search() {
    local term="$1"
    echo -e "${C_AQUA}🔎 Searching in PostgreSQL LoopModules:${C_RESET} '$term'..."
    local res
    if [ -z "$term" ]; then
        res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                     -H "Authorization: Bearer $SUPABASE_KEY" \
                     "$SUPABASE_URL/rest/v1/loop_modules?select=name,version,language,author_name,description&limit=20")
    else
        res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                     -H "Authorization: Bearer $SUPABASE_KEY" \
                     "$SUPABASE_URL/rest/v1/loop_modules?or=(name.ilike.*$term*,description.ilike.*$term*)&select=name,version,language,author_name,description")
    fi

    python3 -c "
import json
data = json.loads('''$res''')
if not data:
    print('  ${C_YELLOW}No matching modules found.${C_RESET}')
else:
    print('')
    for m in data:
        lang = (m.get('language') or 'loop').upper()
        print(f\"  • ${C_BOLD}${C_CYAN}{m['name']}${C_RESET} v{m['version']} [{lang}] by {m.get('author_name')}\")
        print(f\"    ${C_DIM}{m.get('description', '')}${C_RESET}\")
        print('')
"
}

# ── 7. COMMAND: INIT (Create new package) ──
cmd_init() {
    local name="$1"
    local lang="python"
    shift || true

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --lang|-l) lang="$2"; shift ;;
        esac
        shift || true
    done

    if [ -z "$name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Specify module name. Example: ${C_CYAN}smiledev init my-gui --lang python${C_RESET}"
        exit 1
    fi

    local target_dir="./modules/$name"
    mkdir -p "$target_dir"

    local entry=""
    if [ "$lang" == "cpp" ]; then entry="main.hpp"; fi
    if [ "$lang" == "python" ]; then entry="main.py"; fi
    if [ "$lang" == "loop" ]; then entry="main.loop"; fi

    cat <<EOF > "$target_dir/smile.json"
{
  "name": "$name",
  "version": "1.0.0",
  "language": "$lang",
  "entry_point": "$entry",
  "author_name": "Coki Developer",
  "description": "Module $name created with smiledev.",
  "license": "MIT"
}
EOF

    # Code template by language
    if [ "$lang" == "cpp" ]; then
        cat <<EOF > "$target_dir/$entry"
#pragma once
#include <iostream>

namespace $name {
    inline void hello() {
        std::cout << "Hello from C++ module: $name" << std::endl;
    }
}
EOF
    elif [ "$lang" == "python" ]; then
        cat <<EOF > "$target_dir/$entry"
# $name: Python interoperability module for Looping
def init_module(vars_dict=None):
    print("Module $name initialized successfully in PyLoop.")
    return True
EOF
    else
        cat <<EOF > "$target_dir/$entry"
define module "$name" version 1.0:
    fn hello() => "Hello from Looping module $name"
EOF
    fi

    echo -e "${C_GREEN}✔ [CREATED]${C_RESET} Module ${C_BOLD}$name${C_RESET} [$lang] initialized at: ${C_AQUA}$target_dir${C_RESET}"
    echo -e "   To publish to the cloud: ${C_CYAN}smiledev upload-module $target_dir${C_RESET}"
}

# ── 8. AUTO-UPDATER SUB-SYSTEM ──
check_for_updates() {
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    local last_check=0
    if [ -f "$CONFIG_DIR/last_update_check" ]; then
        last_check=$(cat "$CONFIG_DIR/last_update_check" 2>/dev/null || echo 0)
    fi

    # Non-blocking periodic check every 24 hours
    if [ $((now - last_check)) -gt 86400 ]; then
        mkdir -p "$CONFIG_DIR" 2>/dev/null || true
        echo "$now" > "$CONFIG_DIR/last_update_check" 2>/dev/null || true
        (
            remote_json=$(curl -fsSL --connect-timeout 2 "https://repo.cokistudios.com/engine/latest.json" 2>/dev/null || true)
            if [ -n "$remote_json" ]; then
                r_ver=$(echo "$remote_json" | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | cut -d'"' -f4)
                if [ -n "$r_ver" ]; then
                    echo "$r_ver" > "$CONFIG_DIR/latest_available_version" 2>/dev/null || true
                fi
            fi
        ) &>/dev/null &
    fi

    if [ -f "$CONFIG_DIR/latest_available_version" ]; then
        local avail_ver
        avail_ver=$(cat "$CONFIG_DIR/latest_available_version" 2>/dev/null || echo "")
        if [ -n "$avail_ver" ] && [ "$avail_ver" != "$SMILE_VERSION" ]; then
            local is_newer
            is_newer=$(python3 -c "
import sys
try:
    v_avail = [int(x) for x in '$avail_ver'.split('.')]
    v_curr = [int(x) for x in '$SMILE_VERSION'.split('.')]
    print('1' if v_avail > v_curr else '0')
except Exception:
    print('0')
" 2>/dev/null || echo 0)
            if [ "$is_newer" = "1" ]; then
                echo -e "${C_YELLOW}╭────────────────────────────────────────────────────────────╮${C_RESET}"
                echo -e "${C_YELLOW}│${C_RESET} 💡 ${C_BOLD}Update Available:${C_RESET} Looping & smiledev ${C_GREEN}v$avail_ver${C_RESET}             ${C_YELLOW}│${C_RESET}"
                echo -e "${C_YELLOW}│${C_RESET}    Run ${C_CYAN}smiledev upgrade${C_RESET} to update automatically.          ${C_YELLOW}│${C_RESET}"
                echo -e "${C_YELLOW}╰────────────────────────────────────────────────────────────╯${C_RESET}\n"
            fi
        fi
    fi
}

cmd_upgrade() {
    local force_flag=false
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --force|-f) force_flag=true ;;
        esac
        shift || true
    done

    echo -e "${C_CYAN}═══════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BOLD}🚀 COKI STUDIOS ENGINE & SMILEDEV AUTO-UPDATER${C_RESET}"
    echo -e "${C_CYAN}═══════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_DIM}Checking for engine updates on repo.cokistudios.com/engine...${C_RESET}"

    local manifest=""
    local manifest_url="https://repo.cokistudios.com/engine/latest.json"
    manifest=$(curl -fsSL --connect-timeout 6 "$manifest_url" 2>/dev/null || true)

    if [ -z "$manifest" ]; then
        echo -e "${C_DIM}Primary repo mirror unreachable. Trying fallback CDN...${C_RESET}"
        manifest=$(curl -fsSL --connect-timeout 6 "https://cokistudios.github.io/engine/latest.json" 2>/dev/null || true)
    fi

    if [ -z "$manifest" ]; then
        manifest=$(curl -fsSL --connect-timeout 6 "https://raw.githubusercontent.com/CokiStudios/cokistudios.github.io/main/public/engine/latest.json" 2>/dev/null || true)
    fi

    local self_bin
    self_bin="$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
    local repo_root="$(cd "$(dirname "$self_bin")/.." 2>/dev/null && pwd || true)"

    if [ -z "$manifest" ] && [ -n "$repo_root" ] && [ -f "$repo_root/public/engine/latest.json" ]; then
        echo -e "${C_DIM}Network mirrors unreachable. Using local workspace manifest...${C_RESET}"
        manifest=$(cat "$repo_root/public/engine/latest.json")
    fi

    if [ -z "$manifest" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Unable to connect to repo.cokistudios.com/engine or fallback CDN."
        echo -e "   Please verify your network connection and try again."
        exit 1
    fi

    local parsed_info
    parsed_info=$(python3 -c "
import sys, json
try:
    data = json.loads('''$manifest''')
    v = data.get('version', '')
    url = data.get('tarball_url', '')
    sha = data.get('tarball_sha256', '')
    notes = data.get('release_notes', 'Performance and stability improvements.')
    print(f'{v}\t{url}\t{sha}\t{notes}')
except Exception as e:
    sys.exit(1)
" 2>/dev/null || echo "")

    if [ -z "$parsed_info" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Invalid or corrupt manifest received from repo.cokistudios.com/engine."
        exit 1
    fi

    local remote_ver
    local tarball_url
    local expected_sha
    local release_notes
    remote_ver=$(echo "$parsed_info" | awk -F'\t' '{print $1}')
    tarball_url=$(echo "$parsed_info" | awk -F'\t' '{print $2}')
    expected_sha=$(echo "$parsed_info" | awk -F'\t' '{print $3}')
    release_notes=$(echo "$parsed_info" | awk -F'\t' '{print $4}')

    # Check local installed looping
    local looping_bin
    looping_bin="$(command -v looping 2>/dev/null || true)"
    if [ -z "$looping_bin" ] && [ -x "/usr/local/bin/looping" ]; then
        looping_bin="/usr/local/bin/looping"
    elif [ -z "$looping_bin" ] && [ -x "/opt/homebrew/bin/looping" ]; then
        looping_bin="/opt/homebrew/bin/looping"
    fi

    local current_loop_ver="not-installed"
    if [ -n "$looping_bin" ] && [ -x "$looping_bin" ]; then
        current_loop_ver=$("$looping_bin" --version 2>/dev/null | grep -o 'v[0-9.]*' | tr -d 'v' || echo "unknown")
    fi

    echo -e "• Installed smiledev version: ${C_AQUA}v$SMILE_VERSION${C_RESET}"
    echo -e "• Installed looping version:  ${C_AQUA}v$current_loop_ver${C_RESET}"
    echo -e "• Latest available version:   ${C_GREEN}v$remote_ver${C_RESET}"

    local needs_update=0
    if [ "$force_flag" = true ]; then
        needs_update=1
    elif [ "$SMILE_VERSION" != "$remote_ver" ] || [ "$current_loop_ver" != "$remote_ver" ]; then
        needs_update=1
    fi

    if [ "$needs_update" -eq 0 ]; then
        echo -e "\n${C_GREEN}✔ Looping and smiledev are already at the latest version (v$SMILE_VERSION)!${C_RESET}"
        echo -e "${C_DIM}Tip: Pass --force to reinstall anyway: 'smiledev upgrade --force'${C_RESET}"
        return 0
    fi

    echo -e "\n${C_YELLOW}⚡ Initiating upgrade to v$remote_ver...${C_RESET}"
    echo -e "   ${C_DIM}Changelog: $release_notes${C_RESET}"
    echo -e "   Downloading release tarball from: ${C_CYAN}$tarball_url${C_RESET}"

    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/smiledev-upgrade-XXXXXX)
    local tmp_tar="$tmp_dir/engine.tar.gz"

    if ! curl -fsSL "$tarball_url" -o "$tmp_tar" 2>/dev/null; then
        # Try local cache if in repository
        if [ -n "$repo_root" ] && [ -f "$repo_root/public/engine/looping-v${remote_ver}-darwin-universal.tar.gz" ]; then
            echo -e "${C_DIM}Network tarball unavailable. Using workspace package...${C_RESET}"
            cp "$repo_root/public/engine/looping-v${remote_ver}-darwin-universal.tar.gz" "$tmp_tar"
        elif [ -n "$repo_root" ] && [ -f "$repo_root/dist/looping-v${remote_ver}-darwin-universal.tar.gz" ]; then
            echo -e "${C_DIM}Network tarball unavailable. Using dist package...${C_RESET}"
            cp "$repo_root/dist/looping-v${remote_ver}-darwin-universal.tar.gz" "$tmp_tar"
        else
            echo -e "${C_RED}✘ Error:${C_RESET} Failed to download release tarball from $tarball_url."
            rm -rf "$tmp_dir"
            exit 1
        fi
    fi

    if [ -n "$expected_sha" ]; then
        local actual_sha
        actual_sha=$(shasum -a 256 "$tmp_tar" | awk '{print $1}')
        if [ "$actual_sha" != "$expected_sha" ]; then
            echo -e "${C_RED}✘ Security Verification Failed:${C_RESET} SHA256 mismatch!"
            echo -e "   Expected: $expected_sha"
            echo -e "   Got:      $actual_sha"
            rm -rf "$tmp_dir"
            exit 1
        fi
        echo -e "   ${C_GREEN}✔ Checksum verified:${C_RESET} ${C_DIM}$actual_sha${C_RESET}"
    fi

    echo -e "   Unpacking universal binaries..."
    tar -xzf "$tmp_tar" -C "$tmp_dir"

    if [ ! -f "$tmp_dir/looping" ] || [ ! -f "$tmp_dir/smiledev" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Release tarball does not contain required 'looping' or 'smiledev' binaries."
        rm -rf "$tmp_dir"
        exit 1
    fi

    chmod 755 "$tmp_dir/looping" "$tmp_dir/smiledev"

    # Identify target installation directory
    local target_dir="/usr/local/bin"
    if [ -n "$looping_bin" ]; then
        target_dir="$(dirname "$looping_bin")"
    elif [ -d "/opt/homebrew/bin" ] && [ -w "/opt/homebrew/bin" ]; then
        target_dir="/opt/homebrew/bin"
    fi

    echo -e "   Installing into: ${C_BOLD}$target_dir${C_RESET}..."
    local need_sudo=false
    if [ ! -w "$target_dir" ]; then
        need_sudo=true
    fi

    if [ "$need_sudo" = true ]; then
        echo -e "   ${C_YELLOW}🔑 Administrator permissions required for $target_dir. Prompting sudo...${C_RESET}"
        sudo cp "$tmp_dir/looping" "$target_dir/looping"
        sudo chmod 755 "$target_dir/looping"
        sudo ln -sf "$target_dir/looping" "$target_dir/ruuping" 2>/dev/null || true
        sudo cp "$tmp_dir/smiledev" "$target_dir/smiledev"
        sudo chmod 755 "$target_dir/smiledev"
    else
        cp "$tmp_dir/looping" "$target_dir/looping"
        chmod 755 "$target_dir/looping"
        ln -sf "$target_dir/looping" "$target_dir/ruuping" 2>/dev/null || true
        cp "$tmp_dir/smiledev" "$target_dir/smiledev"
        chmod 755 "$target_dir/smiledev"
    fi

    # Also update current script location if it's different from target_dir
    local self_bin
    self_bin="$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
    if [ -f "$self_bin" ] && [ "$self_bin" != "$target_dir/smiledev" ] && [ -w "$self_bin" ]; then
        cp "$tmp_dir/smiledev" "$self_bin"
        chmod 755 "$self_bin"
        local self_dir
        self_dir="$(dirname "$self_bin")"
        if [ -f "$self_dir/looping" ] && [ -w "$self_dir/looping" ]; then
            cp "$tmp_dir/looping" "$self_dir/looping"
            chmod 755 "$self_dir/looping"
        fi
    fi

    # Also sync ~/.local/bin and /opt/homebrew/bin if they exist and are writable
    for extra_dir in "$HOME/.local/bin" "/opt/homebrew/bin"; do
        if [ -d "$extra_dir" ] && [ -w "$extra_dir" ] && [ "$extra_dir" != "$target_dir" ]; then
            if [ -f "$extra_dir/smiledev" ] || [ -f "$extra_dir/looping" ]; then
                cp "$tmp_dir/looping" "$extra_dir/looping"
                chmod 755 "$extra_dir/looping"
                ln -sf "$extra_dir/looping" "$extra_dir/ruuping" 2>/dev/null || true
                cp "$tmp_dir/smiledev" "$extra_dir/smiledev"
                chmod 755 "$extra_dir/smiledev"
                echo -e "   ${C_GREEN}✔ Synchronized binaries in:${C_RESET} $extra_dir"
            fi
        fi
    done

    rm -rf "$tmp_dir"
    rm -f "$CONFIG_DIR/latest_available_version" 2>/dev/null || true
    date +%s > "$CONFIG_DIR/last_update_check" 2>/dev/null || true

    echo -e "\n${C_GREEN}═══════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BOLD}✨ UPGRADE SUCCESSFUL! Looping & smiledev are now v$remote_ver${C_RESET}"
    echo -e "${C_GREEN}═══════════════════════════════════════════════════════════════${C_RESET}"
    if [ -x "$target_dir/looping" ]; then
        echo -n "• Looping:  "
        "$target_dir/looping" --version | head -n1
    fi
    if [ -x "$target_dir/smiledev" ]; then
        echo -n "• smiledev: "
        "$target_dir/smiledev" version
    fi
    echo ""
}

cmd_doctor() {
    print_banner
    echo -e "${C_BOLD}${C_CYAN}[SMILEDEV DOCTOR]${C_RESET} Running diagnostics on Looping & Package Manager...\n"
    echo -e "  ${C_GREEN}✔${C_RESET} smiledev CLI      : v$SMILE_VERSION ($0)"
    local lbin
    lbin=$(command -v looping 2>/dev/null || echo "")
    if [ -n "$lbin" ]; then
        local lver
        lver=$("$lbin" --version 2>/dev/null | head -n1)
        echo -e "  ${C_GREEN}✔${C_RESET} Looping Binary    : $lver ($lbin)"
    else
        echo -e "  ${C_RED}✘${C_RESET} Looping Binary    : Not found in PATH"
    fi
    echo -e "  ${C_GREEN}✔${C_RESET} Global Modules    : $GLOBAL_MODULES_DIR"
    if [ -f "$AUTH_FILE" ]; then
        echo -e "  ${C_GREEN}✔${C_RESET} CS ID Auth        : Authenticated ($AUTH_FILE)"
    else
        echo -e "  ${C_YELLOW}•${C_RESET} CS ID Auth        : Anonymous (run 'smiledev login' to publish)"
    fi
    if curl -fsSL --max-time 4 "https://repo.cokistudios.com/engine/latest.json" >/dev/null 2>&1; then
        echo -e "  ${C_GREEN}✔${C_RESET} Engine Repository : Online (https://repo.cokistudios.com/engine)"
    else
        echo -e "  ${C_YELLOW}•${C_RESET} Engine Repository : Offline / Local Workspace Mode"
    fi
    echo ""
}

cmd_run() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Specify a .loop script or installed module name to run."
        exit 1
    fi
    shift
    if [ -f "$target" ]; then
        exec looping "$target" "$@"
    elif [ -f "$LOCAL_MODULES_DIR/$target/$target.loop" ]; then
        exec looping "$LOCAL_MODULES_DIR/$target/$target.loop" "$@"
    elif [ -f "$GLOBAL_MODULES_DIR/$target/$target.loop" ]; then
        exec looping "$GLOBAL_MODULES_DIR/$target/$target.loop" "$@"
    else
        echo -e "${C_RED}✘ Error:${C_RESET} Could not find script or module '$target'."
        exit 1
    fi
}

# ── COMMAND ROUTER ──
case "$1" in
    help|-h|--help|version|-v|--version|upgrade|self-update|upgrade-engine|"")
        ;;
    *)
        check_for_updates || true
        ;;
esac

case "$1" in
    install|add|i)
        cmd_install "$2"
        ;;
    view|ver|info)
        cmd_ver "$2"
        ;;
    upload-module|upload|publish)
        cmd_upload "$2"
        ;;
    add-repo)
        cmd_add_repo "$2"
        ;;
    list|ls)
        cmd_list
        ;;
    search|find)
        cmd_search "$2"
        ;;
    init|new)
        shift
        cmd_init "$@"
        ;;
    run|exec)
        shift
        cmd_run "$@"
        ;;
    doctor|check)
        cmd_doctor
        ;;
    upgrade|self-update|upgrade-engine)
        shift
        cmd_upgrade "$@"
        ;;
    update)
        shift
        if [ "$1" == "--self" ] || [ -z "$1" ]; then
            cmd_upgrade "$@"
        else
            cmd_install "$1"
        fi
        ;;
    login|auth)
        shift
        cmd_login "$@"
        ;;
    whoami|user)
        cmd_whoami
        ;;
    logout)
        cmd_logout
        ;;
    version|-v|--version)
        echo "smiledev v$SMILE_VERSION (Looping Package Manager)"
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        echo -e "${C_RED}Unknown command:${C_RESET} $1"
        cmd_help
        exit 1
        ;;
esac
