LOCAL_MODULES_DIR="$(pwd)/modules"
CONFIG_FILE="$CONFIG_DIR/config.json"
AUTH_FILE="$CONFIG_DIR/auth.json"

SUPABASE_URL="https://ayxklxciqgqeyuzkziov.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF5eGtseGNpcWdxZXl1emt6aW92Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyMTY4MzIsImV4cCI6MjEwNjc5MjgzMn0.03wUc8blB-cNq9F8Nz5o88GShtMIXeHsNYqmeK_N-hI"

# ANSI Colors and Styles
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_CYAN="\033[38;5;51m"
C_AQUA="\033[38;5;49m"
C_PURPLE="\033[38;5;141m"
C_PINK="\033[38;5;205m"
C_GREEN="\033[38;5;48m"
C_YELLOW="\033[38;5;220m"
C_RED="\033[38;5;196m"
C_BLUE="\033[38;5;39m"

mkdir -p "$CONFIG_DIR" "$GLOBAL_MODULES_DIR"

# Initialize default configuration if it does not exist
if [ ! -f "$CONFIG_FILE" ]; then
    cat <<EOF > "$CONFIG_FILE"
{
  "version": "$SMILE_VERSION",
  "default_repo": "https://repo.cokistudios.com/modules",
  "repos": [
    "https://repo.cokistudios.com/modules",
    "https://ayxklxciqgqeyuzkziov.supabase.co/rest/v1/loop_modules"
  ],
  "author": "Coki Studios Developer"
}
EOF
fi

print_banner() {
    echo -e "${C_CYAN}  _____           _ _      ${C_PURPLE}____${C_RESET}"
    echo -e "${C_CYAN} / ____|         (_) |    ${C_PURPLE}|  _ \   ${C_BOLD}smiledev ${C_AQUA}v$SMILE_VERSION${C_RESET} ${C_YELLOW}(Commercial Edition / Arch $SMILE_ARCH_VERSION)${C_RESET}"
    echo -e "${C_CYAN}| (___  _ __ ___  _| | ___${C_PURPLE}| | | | _____   __${C_RESET}"
    echo -e "${C_CYAN} \___ \| '_ \` _ \| | |/ _ \ ${C_PURPLE}| | |/ _ \ \ / /${C_RESET}"
    echo -e "${C_CYAN} ____) | | | | | | | |  __/${C_PURPLE} |_| |  __/\ V / ${C_RESET}"
    echo -e "${C_CYAN}|_____/|_| |_| |_|_|_|\___${C_PURPLE}|____/ \___| \_/  ${C_DIM}(Looping Universal Package Manager)${C_RESET}"
    echo ""
}

cmd_help() {
    print_banner
    echo -e "${C_BOLD}USAGE:${C_RESET} smiledev <command> [arguments]"
    echo ""
    echo -e "${C_BOLD}PACKAGE & MODULE MANAGEMENT:${C_RESET}"
    echo -e "  ${C_GREEN}install${C_RESET} [module]       Install a module (or all dependencies from smile.json)"
    echo -e "  ${C_RED}uninstall${C_RESET} <module>     Remove a module from local or global environment (--global)"
    echo -e "  ${C_BLUE}update${C_RESET} [module]        Update specified module, all local modules (--all), or self (--self)"
    echo -e "  ${C_YELLOW}list${C_RESET}                   List locally and globally installed modules"
    echo -e "  ${C_AQUA}search${C_RESET} <query>         Search modules in LoopModules cloud registry"
    echo -e "  ${C_BLUE}view${C_RESET} <module>          Show details, version, and author (local or cloud)"
    echo -e "  ${C_CYAN}init${C_RESET} <name> [--lang]   Initialize a new module or project (loop, python, cpp, c2)"
    echo -e "  ${C_PINK}pack${C_RESET} [dir]             Bundle module into release tarball (.tar.gz)"
    echo -e "  ${C_PURPLE}link${C_RESET} [dir]             Symlink local module into global cache for local dev"
    echo -e "  ${C_RED}unlink${C_RESET} <name>          Remove global symlink"
    echo -e "  ${C_GREEN}validate${C_RESET} [dir]         Verify module structure, smile.json compliance & files"
    echo -e "  ${C_AQUA}test${C_RESET} [module]          Execute module tests via Looping engine"
    echo -e "  ${C_AQUA}run${C_RESET} <module|script>    Execute an installed module or .loop script with Looping"
    echo ""
    echo -e "${C_BOLD}REPOSITORY MANAGEMENT & MULTI-SOURCE:${C_RESET}"
    echo -e "  ${C_PURPLE}add-repo${C_RESET} <url|path>    Add an external community repository (HTTP, Git, Local)"
    echo -e "  ${C_BLUE}list-repos${C_RESET}             List all configured repository sources and mirrors"
    echo -e "  ${C_RED}remove-repo${C_RESET} <url|num>  Remove a repository source"
    echo -e "  ${C_YELLOW}repo-spec${C_RESET}              Display technical specification for building external repos"
    echo ""
    echo -e "${C_BOLD}CLOUD REGISTRY & PUBLISHING (CS ID):${C_RESET}"
    echo -e "  ${C_PINK}publish${C_RESET} <dir>          Publish a module to LoopModules registry (requires CS ID)"
    echo -e "  ${C_PINK}upload-module${C_RESET} <dir>    Alias for publish"
    echo ""
    echo -e "${C_BOLD}AUTHENTICATION (CS ID / SMILEDEV):${C_RESET}"
    echo -e "  ${C_GREEN}login${C_RESET} [--token <PAT>]  Authenticate with your Personal Access Token (PAT)"
    echo -e "  ${C_BLUE}whoami${C_RESET}                 Display your authenticated developer identity"
    echo -e "  ${C_RED}logout${C_RESET}                 Sign out and clear local credentials"
    echo ""
    echo -e "${C_BOLD}MAINTENANCE & SYSTEM:${C_RESET}"
    echo -e "  ${C_BLUE}doctor${C_RESET}                 Verify smiledev, Looping engine, compiler & registry health"
    echo -e "  ${C_PURPLE}upgrade${C_RESET} [--force]      Auto-update smiledev & Looping engine from repo.cokistudios.com"
    echo -e "  ${C_YELLOW}clean${C_RESET}                  Clean temporary files and smiledev caches"
