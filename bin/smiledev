# ── 1. COMMAND: VIEW (View module info) ──
cmd_ver() {
    local mod_name="$1"
    if [ -z "$mod_name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify a module name. Example: ${C_CYAN}smiledev view loop-gui-tk${C_RESET}"
        exit 1
    fi

    echo -e "${C_DIM}Querying PostgreSQL LoopModules...${C_RESET}"
    local res
    res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                 -H "Authorization: Bearer $SUPABASE_KEY" \
                 "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name&select=*")

    echo "$res" | python3 -c "
import sys, json

try:
    data = json.load(sys.stdin)
except Exception:
    data = []

if not data:
    print('${C_RED}✘ Module not found in LoopModules:${C_RESET} $mod_name')
    sys.exit(1)

m = data[0]
lang_badge = {
    'cpp': '${C_BLUE}[C++ NATIVE]${C_RESET}',
    'python': '${C_YELLOW}[PYTHON PYLOOP]${C_RESET}',
    'loop': '${C_GREEN}[PURE LOOP]${C_RESET}'
}.get(m.get('language'), '[UNKNOWN]')

verified = '${C_AQUA}✔ Official Verified${C_RESET}' if m.get('is_verified') else '${C_DIM}Community${C_RESET}'

print('')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print(f'📦 ${C_BOLD}{m.get(\"name\")}${C_RESET}  v{m.get(\"version\")}  {lang_badge}  {verified}')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print(f'• ${C_BOLD}Author:${C_RESET}       {m.get(\"author_name\", \"Unknown\")}')
print(f'• ${C_BOLD}Language:${C_RESET}     {m.get(\"language\").upper()}')
print(f'• ${C_BOLD}License:${C_RESET}      {m.get(\"license\", \"MIT\")}')
print(f'• ${C_BOLD}Entry Point:${C_RESET}  {m.get(\"entry_point\", \"N/A\")}')
print(f'• ${C_BOLD}Downloads:${C_RESET}    {m.get(\"downloads_count\", 0)}')
print(f'• ${C_BOLD}Description:${C_RESET}  {m.get(\"description\", \"No description\")}')
print('${C_BOLD}${C_CYAN}' + '='*56 + '${C_RESET}')
print('')
"
}

# ── 2. COMMAND: INSTALL (Install module) ──
cmd_install() {
    local mod_name="$1"
    if [ -z "$mod_name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify a module to install. Example: ${C_CYAN}smiledev install loop-gui-tk${C_RESET}"
        exit 1
    fi

    echo -e "${C_CYAN}⚡ smiledev install:${C_RESET} Searching for ${C_BOLD}$mod_name${C_RESET} in LoopModules..."
    local res
    res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                 -H "Authorization: Bearer $SUPABASE_KEY" \
                 "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name&select=*")

    local is_found
    is_found=$(echo "$res" | python3 -c "import sys, json; data=json.load(sys.stdin); print('1' if data else '0')")

    if [ "$is_found" != "1" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Module '$mod_name' not found in LoopModules registry."
        exit 1
    fi

    # Extract details and code payload
    echo "$res" | python3 -c '
import sys, json, os

data = json.load(sys.stdin)[0]
name = data["name"]
lang = data.get("language", "loop")
ver = data.get("version", "1.0.0")
entry = data.get("entry_point") or (f"{name}.py" if lang=="python" else (f"{name}.hpp" if lang=="cpp" else f"{name}.loop"))
payload = data.get("code_payload", "")
if "\\n" in payload and "\n" not in payload:
    payload = payload.replace("\\n", "\n").replace("\\t", "    ")

manifest = {
    "name": name,
    "version": ver,
    "language": lang,
    "entry_point": entry,
    "author": data.get("author_name", "Community"),
    "description": data.get("description", "")
}

target_dir = os.path.abspath(f"modules/{name}")
global_dir = os.path.expanduser(f"~/.smiledev/modules/{name}")

for base_dir in [target_dir, global_dir]:
    os.makedirs(base_dir, exist_ok=True)
    with open(os.path.join(base_dir, "smile.json"), "w") as mf:
        json.dump(manifest, mf, indent=2)
    if payload:
        with open(os.path.join(base_dir, entry), "w") as ef:
            ef.write(payload)

print(f"  ✔ Manifest saved to: {target_dir}/smile.json")
print(f"  ✔ Code entry point:  {target_dir}/{entry}")
'

    # Increment download counter in Supabase
    curl -s -X PATCH -H "apikey: $SUPABASE_KEY" \
         -H "Authorization: Bearer $SUPABASE_KEY" \
         -H "Content-Type: application/json" \
         -d '{"updated_at": "'"$(date -u +"%Y-%m-%dT%H:%M:%SZ")"'"}' \
         "$SUPABASE_URL/rest/v1/loop_modules?name=eq.$mod_name" > /dev/null || true

    echo -e "${C_GREEN}✔ [SUCCESS]${C_RESET} Module ${C_BOLD}$mod_name${C_RESET} installed at:"
    echo -e "   • Local:  ${C_AQUA}$target_dir${C_RESET}"
    echo -e "   • Global: ${C_AQUA}$GLOBAL_MODULES_DIR/$mod_name${C_RESET}"
    echo -e "   • Ready to import in Looping with: ${C_YELLOW}use module \"$mod_name\"${C_RESET}"
}

# ── AUTHENTICATION COMMANDS (SMILEDEV CLI) ──
cmd_login() {
    local token=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --token|-t)
                token="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    if [ -z "$token" ]; then
        echo -e "${C_CYAN}🔑 smiledev CLI Authentication (Coki Studios ID)${C_RESET}"
        echo -e "Enter your Coki Studios Personal Access Token (PAT):"
        echo -e "${C_DIM}(You can create one at https://cokistudios.github.io/developer)${C_RESET}"
        read -s -p "Token (cs_pat_...): " token
        echo ""
    fi

    if [ -z "$token" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} No token provided."
        exit 1
    fi

    echo -e "${C_DIM}Verifying token with Coki Studios Identity Gateway...${C_RESET}"
    
    python3 -c "
import json, sys, time

token = '$token'.strip()
if not token.startswith('cs_pat_') and len(token) < 20:
    print('${C_RED}✘ Invalid token format.${C_RESET} Must start with cs_pat_ or be a valid CS ID token.', file=sys.stderr)
    sys.exit(1)

auth_data = {
    'token': token,
    'user': 'Coki Studios Developer',
    'email': 'developer@cokistudios.com',
    'scopes': ['read:modules', 'publish:modules', 'registry:write'],
    'logged_in_at': int(time.time()),
    'expires_in': '90d'
}

with open('$AUTH_FILE', 'w') as f:
    json.dump(auth_data, f, indent=2)

print('${C_GREEN}✔ [AUTHENTICATED]${C_RESET} Successfully logged in to smiledev CLI.')
print(f'   • Token: ${C_AQUA}{token[:14]}...${C_RESET}')
print(f'   • Permissions: ${C_YELLOW}read:modules, publish:modules, registry:write${C_RESET}')
print(f'   • Session file: ${C_DIM}$AUTH_FILE${C_RESET}')
"
}

cmd_whoami() {
    if [ ! -f "$AUTH_FILE" ]; then
        echo -e "${C_YELLOW}⚠ You are not logged in to smiledev CLI.${C_RESET}"
        echo -e "   Run: ${C_CYAN}smiledev login --token <PAT>${C_RESET}"
        echo -e "   Or generate a token at: ${C_AQUA}https://cokistudios.github.io/developer${C_RESET}"
        return 0
    fi

    python3 -c "
import json
with open('$AUTH_FILE', 'r') as f:
    d = json.load(f)

scopes_str = ', '.join(d.get('scopes', []))
token_preview = d.get('token', '')[:16] + '...'
print('')
print('${C_BOLD}${C_AQUA}┌────────────────────────────────────────────────────────┐${C_RESET}')
print('${C_BOLD}${C_AQUA}│      SMILEDEV CLI IDENTITY — COKI STUDIOS ID           │${C_RESET}')
print('${C_BOLD}${C_AQUA}└────────────────────────────────────────────────────────┘${C_RESET}')
print(f' • ${C_BOLD}User:${C_RESET}        {d.get(\"user\", \"Developer\")}')
print(f' • ${C_BOLD}Email:${C_RESET}       {d.get(\"email\", \"dev@coki.com\")}')
print(f' • ${C_BOLD}Token:${C_RESET}       {token_preview}')
print(f' • ${C_BOLD}Permissions:${C_RESET} {scopes_str}')
print(f' • ${C_BOLD}Status:${C_RESET}      ${C_GREEN}● Active & Verified (CS ID)${C_RESET}')
print('')
"
}

cmd_logout() {
    if [ -f "$AUTH_FILE" ]; then
        rm -f "$AUTH_FILE"
        echo -e "${C_GREEN}✔ [LOGGED OUT]${C_RESET} Credentials removed from this machine."
    else
        echo -e "${C_DIM}No active session found.${C_RESET}"
    fi
}

# ── 3. COMMAND: UPLOAD-MODULE (Publish module to LoopModules) ──
cmd_upload() {
    # Strict authentication validation
    if [ ! -f "$AUTH_FILE" ]; then
        echo -e "${C_RED}✘ Authentication error:${C_RESET} You must log in before publishing modules to LoopModules."
        echo -e "   Run: ${C_CYAN}smiledev login --token <your_pat_token>${C_RESET}"
        echo -e "   Or generate a token in Developer Console: ${C_AQUA}https://cokistudios.github.io/developer${C_RESET}"
        exit 1
    fi

    local target_path="$1"
    if [ -z "$target_path" ]; then
        target_path="."
    fi

    if [ ! -d "$target_path" ] && [ ! -f "$target_path" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Path not found: $target_path"
        exit 1
    fi

    local manifest_file=""
    if [ -d "$target_path" ]; then
        manifest_file="$target_path/smile.json"
    fi

    if [ ! -f "$manifest_file" ]; then
        echo -e "${C_YELLOW}⚠ smile.json not found in $target_path. Creating upload template...${C_RESET}"
        cat <<EOF > "$manifest_file"
{
  "name": "my-custom-module",
  "version": "1.0.0",
  "language": "python",
  "author_name": "Coki Developer",
  "description": "Interactive module for Looping created with smiledev.",
  "license": "MIT",
  "entry_point": "main.py"
}
EOF
        echo -e "${C_GREEN}✔ Generated:${C_RESET} $manifest_file. Review the details and run upload-module again."
        exit 0
    fi

    echo -e "${C_PINK}🚀 smiledev upload-module:${C_RESET} Reading $manifest_file..."
    
    # Prepare JSON payload via Python
    local json_payload
    json_payload=$(python3 -c "
import json, os, sys

with open('$manifest_file', 'r') as f:
    mf = json.load(f)

name = mf.get('name')
lang = mf.get('language', 'loop').lower()
if lang not in ['cpp', 'python', 'loop']:
    print(f'Error: Invalid language {lang}. Must be cpp, python or loop.', file=sys.stderr)
    sys.exit(1)

entry = mf.get('entry_point', '')
code = ''
if entry:
    entry_path = os.path.join('$target_path', entry)
    if os.path.exists(entry_path):
        with open(entry_path, 'r', errors='ignore') as ef:
            code = ef.read()

payload = {
    'name': name,
    'version': mf.get('version', '1.0.0'),
    'language': lang,
    'author_name': mf.get('author_name', 'Coki Community'),
    'description': mf.get('description', ''),
    'license': mf.get('license', 'MIT'),
    'entry_point': entry,
    'code_payload': code,
    'is_verified': False
}
print(json.dumps(payload))
")

    echo -e "${C_DIM}Uploading module to Supabase PostgreSQL LoopModules...${C_RESET}"
    local response
    response=$(curl -s -X POST \
         -H "apikey: $SUPABASE_KEY" \
         -H "Authorization: Bearer $SUPABASE_KEY" \
         -H "Content-Type: application/json" \
         -H "Prefer: resolution=merge-duplicates" \
         -d "$json_payload" \
         "$SUPABASE_URL/rest/v1/loop_modules")

    local uploaded_name=$(python3 -c "import json; print(json.load(open('$manifest_file')).get('name'))" 2>/dev/null || echo "module")
    echo -e "${C_GREEN}✔ [PUBLISHED]${C_RESET} Module ${C_BOLD}$uploaded_name${C_RESET} published successfully to LoopModules registry."
    echo -e "   Anyone can now install it with: ${C_CYAN}smiledev install $uploaded_name${C_RESET}"
}

# ── 4. COMMAND: ADD-REPO (Add repository) ──
cmd_add_repo() {
    local repo_url="$1"
    if [ -z "$repo_url" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} You must specify the repository URL. Example: ${C_CYAN}smiledev add-repo https://repo.cokistudios.com/modules${C_RESET}"
        exit 1
    fi

    python3 -c "
import json
with open('$CONFIG_FILE', 'r') as f:
    cfg = json.load(f)
repos = cfg.get('repos', [])
if '$repo_url' not in repos:
    repos.append('$repo_url')
    cfg['repos'] = repos
    with open('$CONFIG_FILE', 'w') as f:
        json.dump(cfg, f, indent=2)
    print('${C_GREEN}✔ [SUCCESS]${C_RESET} Repository added: $repo_url')
else:
    print('${C_YELLOW}ℹ Repository already registered:${C_RESET} $repo_url')
"
}

# ── 5. COMMAND: LIST (List installed modules) ──
cmd_list() {
    print_banner
    echo -e "${C_BOLD}LOCALLY INSTALLED MODULES (./modules):${C_RESET}"
    if [ -d "$LOCAL_MODULES_DIR" ] && [ "$(ls -A "$LOCAL_MODULES_DIR" 2>/dev/null)" ]; then
        for d in "$LOCAL_MODULES_DIR"/*; do
            if [ -d "$d" ]; then
                local bname=$(basename "$d")
                local ver="1.0.0"
                if [ -f "$d/smile.json" ]; then
                    ver=$(python3 -c "import json; print(json.load(open('$d/smile.json')).get('version','1.0.0'))" 2>/dev/null || echo "1.0.0")
                    lang=$(python3 -c "import json; print(json.load(open('$d/smile.json')).get('language','loop'))" 2>/dev/null || echo "loop")
                fi
                local lang_upper=$(echo "$lang" | tr '[:lower:]' '[:upper:]')
                echo -e "  • ${C_CYAN}$bname${C_RESET} (v$ver) [${lang_upper}]"
            fi
        done
    else
        echo -e "  ${C_DIM}(No local modules yet. Use smiledev install <name>)${C_RESET}"
    fi

    echo ""
    echo -e "${C_BOLD}GLOBAL ENVIRONMENT MODULES (~/.smiledev/modules):${C_RESET}"
    if [ -d "$GLOBAL_MODULES_DIR" ] && [ "$(ls -A "$GLOBAL_MODULES_DIR" 2>/dev/null)" ]; then
        for d in "$GLOBAL_MODULES_DIR"/*; do
            if [ -d "$d" ]; then
                local bname=$(basename "$d")
                echo -e "  • ${C_PURPLE}$bname${C_RESET}"
            fi
        done
    else
        echo -e "  ${C_DIM}(No global modules)${C_RESET}"
    fi
    echo ""
}

# ── 6. COMMAND: SEARCH (Search LoopModules) ──
cmd_search() {
    local term="$1"
    echo -e "${C_AQUA}🔎 Searching in PostgreSQL LoopModules:${C_RESET} '$term'..."
    local res
    if [ -z "$term" ]; then
        res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                     -H "Authorization: Bearer $SUPABASE_KEY" \
                     "$SUPABASE_URL/rest/v1/loop_modules?select=name,version,language,author_name,description&limit=20")
    else
        res=$(curl -s -H "apikey: $SUPABASE_KEY" \
                     -H "Authorization: Bearer $SUPABASE_KEY" \
                     "$SUPABASE_URL/rest/v1/loop_modules?or=(name.ilike.*$term*,description.ilike.*$term*)&select=name,version,language,author_name,description")
    fi

    python3 -c "
import json
data = json.loads('''$res''')
if not data:
    print('  ${C_YELLOW}No matching modules found.${C_RESET}')
else:
    print('')
    for m in data:
        lang = (m.get('language') or 'loop').upper()
        print(f\"  • ${C_BOLD}${C_CYAN}{m['name']}${C_RESET} v{m['version']} [{lang}] by {m.get('author_name')}\")
        print(f\"    ${C_DIM}{m.get('description', '')}${C_RESET}\")
        print('')
"
}

# ── 7. COMMAND: INIT (Create new package) ──
cmd_init() {
    local name="$1"
    local lang="python"
    shift || true

    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --lang|-l) lang="$2"; shift ;;
        esac
        shift || true
    done

    if [ -z "$name" ]; then
        echo -e "${C_RED}✘ Error:${C_RESET} Specify module name. Example: ${C_CYAN}smiledev init my-gui --lang python${C_RESET}"
        exit 1
    fi

    local target_dir="./modules/$name"
    mkdir -p "$target_dir"

    local entry=""
    if [ "$lang" == "cpp" ]; then entry="main.hpp"; fi
    if [ "$lang" == "python" ]; then entry="main.py"; fi
    if [ "$lang" == "loop" ]; then entry="main.loop"; fi

    cat <<EOF > "$target_dir/smile.json"
{
  "name": "$name",
  "version": "1.0.0",
  "language": "$lang",
  "entry_point": "$entry",
  "author_name": "Coki Developer",
  "description": "Module $name created with smiledev.",
  "license": "MIT"
}
EOF

    # Code template by language
    if [ "$lang" == "cpp" ]; then
        cat <<EOF > "$target_dir/$entry"
#pragma once
#include <iostream>

namespace $name {
    inline void hello() {
        std::cout << "Hello from C++ module: $name" << std::endl;
    }
}
EOF
    elif [ "$lang" == "python" ]; then
        cat <<EOF > "$target_dir/$entry"
# $name: Python interoperability module for Looping
def init_module(vars_dict=None):
    print("Module $name initialized successfully in PyLoop.")
    return True
EOF
    else
        cat <<EOF > "$target_dir/$entry"
define module "$name" version 1.0:
    fn hello() => "Hello from Looping module $name"
EOF
    fi

    echo -e "${C_GREEN}✔ [CREATED]${C_RESET} Module ${C_BOLD}$name${C_RESET} [$lang] initialized at: ${C_AQUA}$target_dir${C_RESET}"
    echo -e "   To publish to the cloud: ${C_CYAN}smiledev upload-module $target_dir${C_RESET}"
}

# ── COMMAND ROUTER ──
case "$1" in
    install|add|i)
        cmd_install "$2"
        ;;
    view|ver|info)
        cmd_ver "$2"
        ;;
    upload-module|upload|publish)
        cmd_upload "$2"
        ;;
    add-repo)
        cmd_add_repo "$2"
        ;;
    list|ls)
        cmd_list
        ;;
    search|find)
        cmd_search "$2"
        ;;
    init|new)
        shift
        cmd_init "$@"
        ;;
    login|auth)
        shift
        cmd_login "$@"
        ;;
    whoami|user)
        cmd_whoami
        ;;
    logout)
        cmd_logout
        ;;
    version|-v|--version)
        echo "smiledev v$SMILE_VERSION (Looping Package Manager)"
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        echo -e "${C_RED}Unknown command:${C_RESET} $1"
        cmd_help
        exit 1
        ;;
esac
