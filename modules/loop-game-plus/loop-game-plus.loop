// ═══════════════════════════════════════════════════════════════
// 🎮 MODULE: loop-game-plus v2.0.0
// Native C++17 3D Projection, 120Hz Physics, Multi-OS Gamepad & Modals
// Coki Studios & Holo Entertainment © 2026
// ═══════════════════════════════════════════════════════════════

define module "loop-game-plus" version 2.0:

    mut pad_connected = false;
    mut pad_x = 0.0;
    mut pad_y = 0.0;
    mut pad_rx = 0.0;
    mut pad_ry = 0.0;
    mut pad_a = false;
    mut pad_b = false;

    mut popup_active = false;
    mut popup_title = "";
    mut popup_code_payload = "";
    mut popup_progress = 0;

    // ── 1. SONDEO DE MANDOS CON ZONA MUERTA RADIAL 3D ──
    fn poll_gamepad(deadzone = 0.15) {
        val raw = game.poll_gamepad();
        mut ax = raw["axis_x"] ?? 0.0;
        mut ay = raw["axis_y"] ?? 0.0;
        val mag = math.hypot(ax, ay);
        if (mag < deadzone) {
            ax := 0.0;
            ay := 0.0;
        }
        pad_connected := raw["connected"] ?? true;
        pad_x := ax;
        pad_y := ay;
        pad_a := raw["btn_a"] ?? false;
        pad_b := raw["btn_b"] ?? false;

        return {
            "connected": pad_connected,
            "x": pad_x,
            "y": pad_y,
            "rx": pad_rx,
            "ry": pad_ry,
            "btn_a": pad_a,
            "btn_b": pad_b
        };
    }

    // ── 2. CÁMARA ORBITAL / CHASE 3D NATIVA (math3d.*) ──
    fn compute_chase_camera(target_pos, yaw_deg = 0.0, pitch_deg = 18.0, distance = 16.0) {
        val q = math3d.quat_euler(pitch_deg, yaw_deg, 0.0);
        val offset = math3d.quat_rotate(q, [0.0, 0.0, -distance]);
        val eye = math3d.add(target_pos, offset);
        val look = math3d.add(target_pos, [0.0, 1.8, 0.0]);
        return {
            "eye": eye,
            "target": look,
            "view_matrix": math3d.mat4_look_at(eye, look, [0.0, 1.0, 0.0])
        };
    }

    // ── 3. PROYECCIÓN Y RENDERIZADO 3D NATIVO C++17 (CERO PYTHON POR VÉRTICE) ──
    fn render_cube(cx, cy, cz, size, rot_x, rot_y, fov = 62, w = 800, h = 480) {
        val s = size / 2.0;
        val q = math3d.quat_euler(rot_x, rot_y, 0.0);
        val center = [cx, cy, cz];
        val eye = [0.0, 0.0, -18.0];
        val look = [0.0, 0.0, 10.0];

        val local_verts = [
            [-s, -s, -s], [s, -s, -s], [s, s, -s], [-s, s, -s],
            [-s, -s,  s], [s, -s,  s], [s, s,  s], [-s, s,  s]
        ];

        mut screen_coords = [];
        for (idx in 0..8) {
            val world_v = math3d.add(center, math3d.quat_rotate(q, local_verts[idx]));
            val pr = math3d.project(world_v, eye, look, fov, w, h);
            screen_coords.push([pr["x"], pr["y"], pr["visible"]]);
        }

        val edges = [
            [0, 1], [1, 2], [2, 3], [3, 0],
            [4, 5], [5, 6], [6, 7], [7, 4],
            [0, 4], [1, 5], [2, 6], [3, 7]
        ];

        for (e in 0..12) {
            val p1 = screen_coords[edges[e][0]];
            val p2 = screen_coords[edges[e][1]];
            if (p1[2] && p2[2]) {
                fx.line(from: (p1[0], p1[1]), to: (p2[0], p2[1]), color: "#38bdf8", stroke: 1.6);
            }
        }
        return screen_coords;
    }

    // ── 4. FÍSICAS RIGIDBODY 3D CON SUB-STEPPING A 120Hz+ ──
    fn step_body_3d(body, dt = 0.0166, substeps = 4) {
        return physics3d.step_body(body, dt, substeps);
    }

    // ── 5. POPUPS IN-GAME Y EVALUACIÓN CONDICIONAL ──
    fn show_popup(title, payload_code) {
        popup_title := title;
        popup_code_payload := payload_code;
        popup_progress := 0;
        popup_active := true;
        audio.tone(880, 50);
    }

    fn update_popup(action_input) {
        if (!popup_active) -> return false;

        ui.card(at: (160, 100), size: (480, 320), title: $"MODAL // {popup_title}", text: "Desafío de Núcleo: Sincroniza al 100% para ejecutar.");
        draw progress at (190, 180) with label "Sincronía" and val popup_progress and bind "p_bar";
        ui.btn(at: (190, 240), text: "[A] PULSO DE POTENCIA", action: "pulse");
        ui.btn(at: (360, 240), text: "[B] CERRAR", action: "cancel");

        match action_input {
            "pulse" => {
                popup_progress += 25;
                audio.tone(550 + (popup_progress * 5), 40);
                if (popup_progress >= 100) {
                    out("[GAME-PLUS] ¡Minijuego completado! Evaluando sub-código condicional...");
                    try {
                        looping.eval(popup_code_payload);
                    } catch (err) {
                        out($"[POPUP EVAL ERROR] {err}");
                    }
                    popup_active := false;
                    return true;
                }
            }
            "cancel" => {
                popup_active := false;
                return false;
            }
            _ => {}
        }
        return false;
    }
