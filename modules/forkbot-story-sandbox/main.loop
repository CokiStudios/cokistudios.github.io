# ═══════════════════════════════════════════════════════════════════
# 🤖 Módulo: forkbot-story-sandbox (main.loop)
# Usa loop-node-window sin modificar el módulo original
# ═══════════════════════════════════════════════════════════════════

define module "forkbot-story-sandbox" version 1.0:
use module "loop-node-window"
import loop.engine as game

# Función simple del modelo algebraico (Innova Mate)
fn calc_force_energy(m, v, h) => (0.5 * m * (v * v)) + (9.8 * m * h);

define game "ForkbotStory" version 1.0:
    create window with title "Forkbot — Historia & Sandbox" and size (760, 440)
    set theme to "dark_neon"

    # ── Mundo y Físicas del Sandbox ──
    game.world(width: 1600, height: 440)
    game.gravity(980)
    game.friction(0.82)
    game.lives(3)

    print "📖 Acto I: Lab Hello! Inc -> USB 'PELIGRO' insertada en Forkbot."
    print "📖 Acto II: Agujero negro de Blueline -> Dimensión Visionaria y Virus."
    print "📖 Acto III: Mundo Roto -> Escombros flotantes y los 760 golpes."

    # ── Protagonista: Forkbot ──
    spawn.player(name: "Forkbot", at: (80, 310), speed: 280, jump: 450, health: 100)

    # ── Escenario 1: Salto de la ventana al techo vecino (Viñeta 19) ──
    spawn.platform(at: (40, 340), size: (180, 18), color: "#38bdf8")
    spawn.pad(at: (190, 324), power: 650)
    spawn.platform(at: (280, 250), size: (160, 18), color: "#6366f1")

    # ── Escenario 2: Agujero Negro y Dimensión Visionaria (Viñetas 25-33) ──
    spawn.orb(at: (490, 210), power: 580, color: "#c084fc")
    spawn.spike(at: (520, 396), size: (50, 20), damage: 25)
    spawn.moving_platform(at: (580, 230), size: (140, 18), range: (540, 760), speed: 85, color: "#c084fc")
    spawn.heart(at: (640, 180), heal: 35)

    # ── Escenario 3: Fragmentos de suelo en el aire y Blueline (Viñetas 35-44) ──
    spawn.moving_platform(at: (830, 280), size: (130, 18), range: (800, 1020), speed: 95, color: "#06b6d4")
    spawn.platform(at: (1080, 220), size: (160, 18), color: "#38bdf8")
    spawn.coin(at: (880, 230), points: 200)
    spawn.coin(at: (1140, 170), points: 300)

    spawn.enemy(name: "Blueline", at: (1280, 340), range: (1200, 1420), speed: 80, health: 100)
    spawn.portal(at: (1480, 328), label: "FIN DE LA PESADILLA")