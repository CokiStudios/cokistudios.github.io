import loop.ui as ui
import loop.engine as game

define app "HoloArcade2D" version 2.0:
    create window with title "Shine Loop: Holo Arcade Core" and size (720, 480)
    set theme to "dark_neon"
    
    set player_name to "Angel Helium"
    set console_target to "Shine Loop Handheld / Console"
    
    print "Booting Holo Looping OoS Linux Gaming Subsystem..."
    print "[GAME] Target Platform:", console_target
    print "Player Active:", player_name
    
    # ── UI HUD Glassmorphism Elements ──
    draw card at (30, 30) with size (260, 110) and title "Shine Loop Console" and text "OS: Holo Looping OoS\nPipeline: 60 FPS Low-Latency\nStatus: Gamepad Synced"
    draw button at (30, 155) with text "Pulse Core Blast" and action "pulse_boost"

    # ── Floating Platforms ──
    spawn platform at (200, 330) with size (150, 16) and color "#6366f1"
    spawn platform at (420, 260) with size (160, 16) and color "#8b5cf6"

    # ── Collectible Energy Stars / Coins ──
    spawn coin at (275, 290) with points 100
    spawn coin at (500, 220) with points 250
    spawn coin at (640, 380) with points 500

    # ── 2D Sprite Entities (Player & NPCs) ──
    spawn sprite "AngelHelium" at (120, 380) with color "#38bdf8" and size (34, 46)
    spawn sprite "CorruptedForkbot" at (480, 380) with color "#ef4444" and size (34, 46)
    
    print "[GAME] Controls: [A/D] Move • [W/Space] Float Jump • Collect * Stars to Score!"
