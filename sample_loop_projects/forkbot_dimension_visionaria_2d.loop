# ═══════════════════════════════════════════════════════════════
#  FORKBOT: DIMENSION VISIONARIA — PORT 2D COMPLETO (ARCH 3.1A)
#  Pure 2D Looping + Gamepad + Loopize++ + Algebra Sandbox UI
# ═══════════════════════════════════════════════════════════════

use loop-node-window
use loop.engine as game
use loop.ui as ui
use loop-game-plus
use pyloop-gamepad
use loopize++

set ui_profile to "cyber_neon_xui"
window.create("Forkbot: Dimension Visionaria 2D (Arch 3.1A)", 1280, 720)
game.mode("2d")
game.world(width: 3600, height: 500)
game.scenario(name: "Dimension Visionaria 2D", weather: "void", bg: "#040914", accent: "#00f5d4")
game.physics(gravity: 980, friction: 0.84, time_scale: 1.0)
game.lives(3)

gamepad.init(profile: "universal", deadzone: 0.15)
gamepad.bind(move: "left_stick|dpad", jump: "A", shoot: "X|RT", dash: "B|LT", prev_stage: "LB", next_stage: "RB", reset: "START")

define game "Forkbot 2D Arena" version 3.1:

# Historia Lineal por Etapas (Novela Grafica -> Jugable 2D)
game.stage_preset(name: "Cap 1: Lab Hello! Inc (USB PELIGRO)", at: (60, 310), gravity: 980, friction: 0.84, weather: "clear", bg: "#06101f", accent: "#38bdf8")
game.stage_preset(name: "Cap 2-3: Ciudad (CRACK! & Vortice GLUP)", at: (920, 260), gravity: 920, friction: 0.82, weather: "void", bg: "#0a1026", accent: "#00f5d4")
game.stage_preset(name: "Cap 4: Dimension Visionaria (0.36G)", at: (1820, 220), gravity: 353, friction: 0.90, weather: "void", bg: "#14072b", accent: "#a855f7")
game.stage_preset(name: "Cap 5-6: Hora de la Verdad (Blueline)", at: (2720, 270), gravity: 980, friction: 0.85, weather: "ember", bg: "#1f0610", accent: "#f43f5e")

spawn.player(name: "Forkbot", at: (60, 310), speed: 260, jump: 450, color: "#00f5d4")
spawn.platform(at: (0, 440), size: (3600, 60), color: "#1e293b")

# Cap 1: Laboratorio Hello! Incorporated
spawn.breakable(at: (300, 340), size: (28, 100), health: 30, color: "#38bdf8")
spawn.enemy(name: "SecDrone", at: (560, 396), size: (34, 44), range: (440, 720), speed: 85, health: 40, color: "#38bdf8")
spawn.checkpoint(at: (820, 380), label: "USB_PELIGRO", color: "#f43f5e")

# Cap 2-3: Ciudad & Vortice GLUP
spawn.moving_platform(at: (1060, 320), size: (120, 18), axis: "x", range: (1000, 1340), speed: 95, color: "#00f5d4")
spawn.enemy(name: "Valkyrie", at: (1480, 396), size: (34, 44), range: (1360, 1660), speed: 105, health: 55, color: "#38bdf8")
spawn.teleporter(at: (1720, 360), to: (1840, 220), label: "VORTICE_GLUP", color: "#a855f7")

# Cap 4: Dimension Visionaria
spawn.gravity_zone(at: (1800, 40), size: (840, 390), scale: 0.36, label: "DIMENSION_VISIONARIA", color: "#a855f7")
spawn.orb(at: (1960, 240), power: 480, color: "#facc15")
spawn.moving_platform(at: (2120, 270), size: (110, 18), axis: "y", range: (160, 340), speed: 80, color: "#a855f7")
spawn.enemy(name: "VirusNode", at: (2380, 396), size: (34, 44), range: (2240, 2560), speed: 100, health: 60, color: "#f43f5e")
spawn.checkpoint(at: (2640, 380), label: "PUERTA_BLANCA", color: "#f8fafc")

# Cap 5-6: Hora de la Verdad (4 anos despues)
spawn.checkpoint(at: (2780, 380), label: "4_ANOS_DESPUES", color: "#f43f5e")
spawn.boss(name: "Blueline", at: (3140, 358), size: (68, 86), range: (2880, 3360), speed: 115, health: 500, fire_rate: 1.4, color: "#38bdf8")
spawn.portal(at: (3460, 372), size: (46, 68), label: "FIN_PESADILLA")

# Sandbox Variables & Sliders (Fuerza, Velocidad, Corrupcion)
set sb_force = 100
set sb_speed = 1.0
set sb_corr = 15
set sb_vel = py!(round(12.5 * sb_speed, 2))
set sb_force_n = py!(round(420.0 * (sb_force / 100.0), 1))

ui.header("FORKBOT: DIMENSION VISIONARIA 2D — LOOPING ARCH 3.1A")
ui.split("left_robot", "right_tables", 0.45)

ui.panel("left_robot", "Viewport 2D & Historia")
ui.label("Forkbot vs Blueline Titan | Native 2D Engine + Loopize++")
draw card at (20, 20) size (330, 110) title "Forkbot Telemetry" text "F={sb_force_n}N | V={sb_vel}m/s | Corr={sb_corr}%"
ui.toggle("Overdrive 760x", false, "sb_overdrive")
ui.toggle("2D FX Neon", true, "sb_2d_fx")

ui.panel("right_tables", "Sandbox: Fuerza, Velocidad y Corrupcion")
ui.slider("Fuerza (%)", 10, 250, 100, "sb_force")
ui.slider("Velocidad (x)", 0.2, 4.0, 1.0, "sb_speed")
ui.slider("Corrupcion (%)", 0, 100, 15, "sb_corr")
ui.progress("Fuerza", 40, 100, "#38bdf8")
ui.progress("Velocidad", 25, 100, "#00f5d4")
ui.progress("Corrupcion", 15, 100, "#f43f5e")
draw button at (20, 186) text "Step Simulation" action "lz_step(0.25)"
ui.button("Reset Sandbox", "restart")

ui.algebra_table(title: "Fuerza | Velocidad | Corrupcion", formula: "0.5*m*v^2 + 9.8*m*h", threshold: 760)
ui.algebra_row(label: "Cap 1: Lab (Corr 15%)", m: 40, v: 10.0, h: 1.2, hits: 10)
ui.algebra_row(label: "Cap 4: Visionaria (Corr 45%)", m: 40, v: 16.0, h: 4.5, hits: 180)
ui.algebra_row(label: "Cap 5: ARGGGRGRG (Corr 95%)", m: 40, v: 32.0, h: 2.0, hits: 520)
ui.algebra_row(label: "Cap 6: Overdrive (Corr 100%)", m: 40, v: 45.0, h: 2.0, hits: 760)

lz_banner("FORKBOT: DIMENSION VISIONARIA 2D")
loopize.ecs_spawn("Forkbot", "player", 60, 310, 0, 100, 260)
loopize.ecs_spawn("Blueline", "boss", 3140, 358, 0, 500, 115)
loopize.spatial_radius(3140, 358, 0, 180)
loopize.inventory_add("usb_peligro", 1)
loopize.inventory_add("overdrive_cell", 1)

lz_fsm("StoryChapter", "LAB_USB_PELIGRO")
lz_tween("SpeedBoost", 1.0, 1.8, 0.5)
lz_wave_rush(1, "valkyrie", 2, 120)
lz_mission("Cap 1-3: Lab y Vortice", 50)
lz_step(0.25)

lz_fsm("StoryChapter", "DIMENSION_VISIONARIA")
lz_hit_combo(6)
loopize.quest_progress("Cap 4: Dimension Visionaria", 75)
lz_step(0.25)

lz_fsm("StoryChapter", "FIN_PESADILLA")
loopize.inventory_use("overdrive_cell", 1)
lz_hit_combo(12)
lz_mission("Cap 5-6: Fin a la Pesadilla", 100)
lz_step(0.25)

lz_report()
