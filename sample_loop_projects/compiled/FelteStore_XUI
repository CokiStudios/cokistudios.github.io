# ── Instalador y Compilador Dinámico de Paquetes en Felte ──

fn install_and_compile_package(pkg_id) {
    if (pkg_id == "1") {
        print ""
        print "📦 [FELTE] Descargando manifiesto de 'Holo Arcade 2D'..."
        play tone at 659 Hz for 80 ms
        print "⚡ [LOOP COMPILER] Verificando dependencias de sprites y audio..."
        compile program "HoloArcadeStandalone" target "shine_ui" to "sample_loop_projects/compiled/HoloArcadeStandalone":
            title "Holo Arcade 2D - Shine Loop"
            size (800, 480)
            theme "aurora_indigo_fold"
            draw card at (20, 20) with size (760, 80) and title "HOLO ARCADE 2D" and text "Instalado desde Felte Store. Plataformas 2D a 60 FPS nativos."
            code:
                print "[ARCADE] Iniciando bucle de juego retro..."
                play tone at 880 Hz for 100 ms
        play_install_chime()
        print "✔ 'Holo Arcade 2D' compilado e instalado en: sample_loop_projects/compiled/HoloArcadeStandalone"
    }
    if (pkg_id == "2") {
        print ""
        print "📦 [FELTE] Instalando hiOP IDE Studio v3.0..."
        play tone at 587 Hz for 80 ms
        val ide_src = "print '[hiOP IDE] Entorno de desarrollo Shine Loop iniciado.'; audio.tone(523, 90)"
        val path = compiler.compile(ide_src, "xui", "sample_loop_projects/compiled/hiOP_IDE_App")
        play_install_chime()
        print $"✔ 'hiOP IDE Studio' instalado exitosamente en: {path}"
    }
    if (pkg_id == "3") {
        print ""
