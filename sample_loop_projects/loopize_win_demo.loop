use module "loop.engine" as gameuse module "loop.ui"use "loopize++"use "csharp"set ui_profile to "cyber_neon_xui"window.create("Forkbot Sandbox v1.1", 760, 440)game.world(width: 3200, height: 440)game.scenario(name: "Forkbot Campaign", weather: "void", bg: "#050816", accent: "#38bdf8")game.physics(gravity: 980, friction: 0.82, time_scale: 1.0)game.lives(3)game3d "Forkbot 3D + UI" version 3.0:scene3d.world(name: "ForkbotArena", sky: "cyber_night", fog: 0.01)camera3d.set(0, 5.5, -15.0, 0, 1.5, 0, 60.0)light3d.directional(0.4, -1.0, 0.3, 1.0, "#38bdf8")physics3d.config(-24.0, 0.82, 4)cs! {    public class ForkbotController : MonoBehaviour {        public float fuerza = 1600.0f;        public float velocidad = 10.0f;        public float corrupcion = 15.0f;        public void Start() {            LoopingBridge.Set("fuerza", fuerza);            LoopingBridge.Set("velocidad", velocidad);            LoopingBridge.Set("corrupcion", corrupcion);        }        public void Update(float dt) {            Scene3D.Rotate("Forkbot", 0.0f, 35.0f * dt, 0.0f);        }    }}game.stage_preset(name: "Stage 1: Lab", at: (60, 280), gravity: 980, friction: 0.82, weather: "clear", bg: "#06101f", accent: "#38bdf8")game.stage_preset(name: "Stage 2: 0.36G", at: (860, 220), gravity: 353, friction: 0.90, weather: "void", bg: "#0f0724", accent: "#a855f7")game.stage_preset(name: "Stage 3: Broken", at: (1780, 250), gravity: 880, friction: 0.78, weather: "ember", bg: "#1a0c0a", accent: "#f97316")game.stage_preset(name: "Stage 4: Coliseum", at: (2580, 260), gravity: 980, friction: 0.85, weather: "void", bg: "#1f0810", accent: "#ef4444")spawn.player(name: "Forkbot", at: (60, 280), speed: 260, jump: 440, color: "#38bdf8")spawn.breakable(at: (240, 220), size: (24, 100), health: 30, color: "#38bdf8")spawn.gravity_zone(at: (800, 40), size: (900, 350), scale: 0.36, label: "ZONE_036G", color: "#a855f7")spawn.teleporter(at: (1620, 180), to: (1780, 250), label: "WARP_PORTAL", color: "#00f5d4")spawn.boss(name: "Blueline", at: (2860, 310), size: (62, 82), range: (2620, 3050), speed: 110, health: 450, fire_rate: 1.5, color: "#38bdf8")spawn.portal(at: (3120, 320), size: (44, 68), label: "EXIT")loopize.ecs_spawn("Forkbot", "player", -3.0, 0.0, 0.0, 100, 10.0)loopize.ecs_spawn("Blueline", "boss", 3.0, 0.0, 0.0, 450, 14.0)ui.header("FORKBOT SANDBOX v1.1")ui.split("left_robot", "right_tables", 0.45)ui.panel("left_robot", "Viewport 3D")ui.label("Unit: Forkbot | State: Active")draw card at (20, 20) size (300, 110) title "Forkbot Telemetry" text "Sync: cs! + loopize++"draw input at (20, 140) size (220, 36) placeholder "Speed multiplier (1.0 - 4.0)" var "sb_mult"draw button at (20, 186) text "Step Simulation" action "lz_step"ui.panel("right_tables", "Live Metrics")ui.slider("Speed Multiplier", 0.5, 4.0, 1.0, "sb_mult")ui.slider("Corruption Level", 0, 100, 15, "sb_corr")ui.progress("Force Output", 75, 100, "#38bdf8")ui.progress("Corruption", 15, 100, "#a855f7")ui.button("Reset Sandbox", "restart")ui.algebra_table(title: "Force | Velocity | Corruption", formula: "0.5*m*v^2 + 9.8*m*h", threshold: 760)ui.algebra_row(label: "Stage 1 (Corr 15%)", m: 40, v: 10.0, h: 1.2, hits: 10)ui.algebra_row(label: "Stage 2 (Corr 65%)", m: 40, v: 16.0, h: 4.5, hits: 180)ui.algebra_row(label: "Stage 3 (Corr 40%)", m: 40, v: 22.0, h: 3.0, hits: 420)ui.algebra_row(label: "Stage 4 (Corr 98%)", m: 40, v: 45.0, h: 2.0, hits: 760)lz_fsm("State", "STAGE_1")lz_step(0.25)lz_fsm("State", "STAGE_2")lz_hit_combo(3)lz_step(0.25)lz_fsm("State", "STAGE_3")lz_step(0.25)lz_fsm("State", "STAGE_4")lz_hit_combo(12)lz_step(0.25)scene3d.render_tui(40, 12)lz_report()